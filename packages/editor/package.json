{
  "name": "@tellplot/editor",
  "version": "1.0.0",
  "description": "Lightweight editable React charts built on AntV G2",
  "license": "MIT",
  "homepage": "https://tellplot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/tellplot.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/iiwish/tellplot/issues"
  },
  "keywords": [
    "charts",
    "react",
    "g2",
    "waterfall",
    "bar-chart",
    "column-chart",
    "data-visualization"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:package": "publint && attw --pack . --exclude-entrypoints ./styles.css && node tests/package/import-esm.mjs && node tests/package/import-cjs.cjs && tsc -p tests/package/tsconfig.json && node tests/package/pack-contract.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@antv/g2": "^5.4.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@antv/g2": "5.4.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@antv/g-svg": "2.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "lucide-react": "1.24.0"
  }
}
