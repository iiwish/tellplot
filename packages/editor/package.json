{
  "name": "@tellplot/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral editable charts built on AntV G2",
  "license": "MIT",
  "homepage": "https://tellplot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/tellplot.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/iiwish/tellplot/issues"
  },
  "keywords": [
    "charts",
    "framework-neutral",
    "g2",
    "waterfall",
    "bar-chart",
    "column-chart",
    "data-visualization"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. exec vitest run packages/editor/tests",
    "test:package": "publint && attw --pack . --exclude-entrypoints ./styles.css && node tests/package/import-esm.mjs && node tests/package/import-cjs.cjs && tsc -p tests/package/tsconfig.json && node tests/package/pack-contract.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@antv/g2": "5.4.8"
  },
  "devDependencies": {
    "@antv/g2": "5.4.8"
  },
  "dependencies": {
    "@tellplot/core": "workspace:*",
    "@antv/g-svg": "2.1.1"
  }
}
