{
  "name": "tellplot",
  "version": "2.0.0",
  "description": "Framework-neutral editable charts for DOM, React and Vue, built on AntV G2",
  "license": "MIT",
  "homepage": "https://tellplot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/tellplot.git",
    "directory": "packages/tellplot"
  },
  "bugs": {
    "url": "https://github.com/iiwish/tellplot/issues"
  },
  "keywords": [
    "charts",
    "editable-charts",
    "g2",
    "react",
    "vue",
    "waterfall",
    "data-visualization"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/tellplot/tests",
    "test:package": "publint && attw --pack . --profile node16 --exclude-entrypoints ./styles.css && node tests/package/import-esm.mjs && node tests/package/import-cjs.cjs && tsc -p tests/package/tsconfig.json && node tests/package/pack-contract.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@antv/g-svg": "2.1.1",
    "@antv/g2": "5.4.8"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tellplot/core": "workspace:*",
    "@tellplot/editor": "workspace:*",
    "@tellplot/react": "workspace:*",
    "@tellplot/vue": "workspace:*",
    "react": "19.2.7",
    "vue": "3.5.27"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
