+          path: '/items/1/amount',
+          details: { operation: 'accumulate', sourceIndex: 1 },
+        },
+      ],
+    });
+    expect(result).not.toHaveProperty('value');
+    expect(JSON.stringify(result)).not.toContain('Private');
