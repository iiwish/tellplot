+    expect(() => store.update(invalidOptions)).not.toThrow();
+    expect(store.getSnapshot()).toMatchObject({ status: 'invalid', issues: [expect.any(Object)] });
+    expect(store.getSnapshot().issues[0]).toMatchObject({
