-  axis: CategoryAxis,
-): ChartCategoryHitResult {
-  if (
-    !validAxis(axis) ||
-    !validPoint(point) ||
-    !Number.isFinite(minimumTargetSize) ||
-    minimumTargetSize <= 0
-  ) {
-    return { ok: false, reason: 'INVALID_INPUT' };
-  }
-
-  let best:
-    | {
-        readonly bounds: ChartSceneRectangle;
-        readonly distance: number;
-        readonly centerDistance: number;
