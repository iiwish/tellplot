-    ok: true,
-    hit: {
-      nodeId: categoryBounds.nodeId,
-      edge,
-      min: categoryBounds.min,
-      max: categoryBounds.max,
-      target: edge === 'before' ? categoryBounds.min : categoryBounds.max,
-    },
-  };
-}
