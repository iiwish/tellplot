-    leafIds.some(itemId => {
-      const item = sourceItems.get(itemId);
-      return (
-        item === undefined ||
-        (!categoricalSource && (!('kind' in item) || item.kind !== 'contribution')) ||
-        viewSpec.pinnedItemIds.includes(itemId)
