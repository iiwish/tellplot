+      ...baseView(),
+      rootOrder: ['parent', 'd'],
+      groups: {
+        parent: { id: 'parent', label: 'Parent', childIds: ['a', 'b', 'c'] },
+      },
+      collapsedGroupIds: [],
+    };
+    const session = createEditorSession(sourceData, { viewSpec: parentView });
+    expect(session.ok).toBe(true);
+    if (!session.ok) {
+      return;
+    }
+    const result = executeCommand(
+      session.value,
+      command('createGroup', {
+        groupId: 'child',
+        label: 'Child',
+        nodeIds: ['a', 'b'],
+        initiallyCollapsed: false,
+      }),
