-  if (first === undefined) {
-    return 0;
-  }
-  let length = 0;
-  while (
-    length < first.length &&
-    paths.every(path => path[length] !== undefined && path[length] === first[length])
-  ) {
-    length += 1;
-  }
-  return length;
-}
