-  const firstIndex = values.indexOf(orderedIds[0] as ViewNodeId);
-  const contiguous = orderedIds.every((nodeId, offset) => values[firstIndex + offset] === nodeId);
-  if (!contiguous) {
-    return { ok: false, reason: 'NON_CONTIGUOUS_GROUP_SELECTION' };
-  }
