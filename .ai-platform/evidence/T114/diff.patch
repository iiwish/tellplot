+  });
+
+  it('ignores value-axis movement and distinguishes threshold from no target', () => {
+    const bounds = categoryBounds(verticalSceneBounds, 'y');
+    expect(
+      resolveChartCategoryDropTarget(
+        dropInput('y', bounds, { x: 0, y: 120 }, { x: 10_000, y: 123.99 }),
