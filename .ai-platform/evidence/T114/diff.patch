+          bounds[2] as ChartCategoryBounds,
+        ],
+      }),
+    ).toEqual({ ok: true, target: { nodeId: 'left', edge: 'before', target: 20 } });
+  });
+});
+
+describe('category-axis minimum pointer target', () => {
+  it('keeps two-dimensional hit testing while selecting edge on X or Y', () => {
