+    ).toEqual({ ok: true, target: { nodeId: 'right', edge: 'after', target: 220 } });
+    expect(
+      resolveChartCategoryDropTarget({
+        ...dropInput('x', bounds, { x: 200, y: 0 }, { x: 40, y: 0 }),
+        itemId: 'right',
+        orderedBounds: [
