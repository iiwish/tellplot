+import {
+  Download,
+  PanelLeft,
+  PanelRight,
+  Redo2,
+  ShieldCheck,
+  TriangleAlert,
+  Undo2,
+} from 'lucide-react';

+import type { EditorMessages } from './editorMessages';

+interface EditorToolbarProps {
+  readonly datasetId: string;
+  readonly messages: EditorMessages;
+  readonly valid: boolean;
+  readonly showOutline: boolean;
+  readonly showInspector: boolean;
+  readonly showToolbar: boolean;
+  readonly onOpenOutline: () => void;
+  readonly onOpenInspector: () => void;
+}

+function DisabledTool({
+  label,
+  reason,
+  children,
+}: {
+  readonly label: string;
+  readonly reason: string;
+  readonly children: React.ReactNode;
+}): React.JSX.Element {
+  return (
+    <button
+      className="gt-icon-button"
+      type="button"
+      aria-label={label}
+      aria-description={reason}
+      title={reason}
+      disabled
+    >
+      {children}
+    </button>
+  );
+}

+export function EditorToolbar({
+  datasetId,
+  messages,
+  valid,
+  showOutline,
+  showInspector,
+  showToolbar,
+  onOpenOutline,
+  onOpenInspector,
+}: EditorToolbarProps): React.JSX.Element {
+  const statusLabel = valid ? messages.validated : messages.invalidData;

+  return (
+    <header className="gt-toolbar" role="toolbar" aria-label={messages.toolbar}>
+      <div className="gt-brand-block">
+        <span className="gt-brand-mark" aria-label="g2touch">
+          g2touch
+        </span>
+        <span className="gt-toolbar-divider" aria-hidden="true" />
+        <span className="gt-dataset-title" title={datasetId}>
+          {datasetId}
+        </span>
+      </div>

+      <div className="gt-toolbar-status" data-valid={valid} aria-label={statusLabel}>
+        {valid ? (
+          <ShieldCheck size={15} aria-hidden="true" />
+        ) : (
+          <TriangleAlert size={15} aria-hidden="true" />
+        )}
+        <span>{statusLabel}</span>
+      </div>

+      <div className="gt-toolbar-actions">
+        {showOutline ? (
+          <button
+            className="gt-icon-button gt-outline-trigger"
+            type="button"
+            aria-label={messages.openOutline}
+            title={messages.openOutline}
+            onClick={onOpenOutline}
+          >
+            <PanelLeft size={17} aria-hidden="true" />
+          </button>
+        ) : null}
+        {showInspector ? (
+          <button
+            className="gt-icon-button gt-inspector-trigger"
+            type="button"
+            aria-label={messages.openInspector}
+            title={messages.openInspector}
+            onClick={onOpenInspector}
+          >
+            <PanelRight size={17} aria-hidden="true" />
+          </button>
+        ) : null}
+        {showToolbar ? (
+          <>
+            <span className="gt-action-divider" aria-hidden="true" />
+            <DisabledTool label={messages.undo} reason={messages.undoUnavailable}>
+              <Undo2 size={17} aria-hidden="true" />
+            </DisabledTool>
+            <DisabledTool label={messages.redo} reason={messages.redoUnavailable}>
+              <Redo2 size={17} aria-hidden="true" />
+            </DisabledTool>
+            <DisabledTool label={messages.export} reason={messages.exportUnavailable}>
+              <Download size={17} aria-hidden="true" />
+            </DisabledTool>
+          </>
+        ) : null}
+      </div>
+    </header>
+  );
+}
