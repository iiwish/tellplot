diff --git a/packages/editor/src/components/OutlinePanel.tsx b/packages/editor/src/components/OutlinePanel.tsx
new file mode 100644
index 0000000..8f17487
--- /dev/null
+++ b/packages/editor/src/components/OutlinePanel.tsx
@@ -0,0 +1,167 @@
+import { ChevronDown, ChevronRight, GripVertical, LockKeyhole } from 'lucide-react';

+import type { SourceData, ViewGroup, ViewSpec } from '../domain/model';
+import type { SelectionState } from '../react/editorTypes';
+import type { WaterfallDatum, WaterfallProjection } from '../waterfall/waterfallTypes';
+import type { EditorMessages } from './editorMessages';
+import { formatAmount, type EditorLocale } from './formatAmount';

+interface OutlineEntry {
+  readonly nodeId: string;
+  readonly label: string;
+  readonly amount: number | null;
+  readonly sourceIds: readonly string[];
+  readonly locked: boolean;
+  readonly level: number;
+  readonly expanded?: boolean;
+  readonly groupSize?: number;
+}

+interface OutlinePanelProps {
+  readonly sourceData: SourceData;
+  readonly viewSpec: ViewSpec;
+  readonly projection: WaterfallProjection;
+  readonly locale: EditorLocale;
+  readonly messages: EditorMessages;
+  readonly selectedNodeId: string | null;
+  readonly onSelect: (selection: SelectionState) => void;
+}

+function ownGroup(viewSpec: ViewSpec, nodeId: string): ViewGroup | undefined {
+  const descriptor = Object.getOwnPropertyDescriptor(viewSpec.groups, nodeId);
+  return descriptor !== undefined && 'value' in descriptor
+    ? (descriptor.value as ViewGroup)
+    : undefined;
+}

+function contributionGroup(viewSpec: ViewSpec, nodeId: string): ViewGroup | undefined {
+  for (const group of Object.values(viewSpec.groups)) {
+    if (group.childIds.includes(nodeId)) {
+      return group;
+    }
+  }
+  return undefined;
+}

+function groupEntry(
+  group: ViewGroup,
+  datum: WaterfallDatum | undefined,
+  expanded: boolean,
+): OutlineEntry {
+  return {
+    nodeId: group.id,
+    label: group.label,
+    amount: datum?.amount ?? null,
+    sourceIds: [...group.childIds],
+    locked: datum?.locked ?? false,
+    level: 1,
+    expanded,
+    groupSize: group.childIds.length,
+  };
+}

+function outlineEntries(
+  viewSpec: ViewSpec,
+  projection: WaterfallProjection,
+): readonly OutlineEntry[] {
+  const entries: OutlineEntry[] = [];
+  const emittedGroups = new Set<string>();

+  for (const datum of projection) {
+    const own = ownGroup(viewSpec, datum.nodeId);
+    if (own !== undefined) {
+      emittedGroups.add(own.id);
+      entries.push(groupEntry(own, datum, false));
+      continue;
+    }

+    const parent = contributionGroup(viewSpec, datum.nodeId);
+    if (parent !== undefined && !emittedGroups.has(parent.id)) {
+      emittedGroups.add(parent.id);
+      entries.push(groupEntry(parent, undefined, true));
+    }

+    entries.push({
+      nodeId: datum.nodeId,
+      label: datum.label,
+      amount: datum.amount,
+      sourceIds: [...datum.sourceIds],
+      locked: datum.locked,
+      level: parent === undefined ? 1 : 2,
+    });
+  }

+  return entries;
+}

+export function OutlinePanel({
+  sourceData,
+  viewSpec,
+  projection,
+  locale,
+  messages,
+  selectedNodeId,
+  onSelect,
+}: OutlinePanelProps): React.JSX.Element {
+  const entries = outlineEntries(viewSpec, projection);

+  return (
+    <div className="gt-panel-body gt-outline-body">
+      <div className="gt-panel-heading">
+        <h2>{messages.outline}</h2>
+        <span>{entries.length}</span>
+      </div>
+      <div className="gt-outline-tree" role="tree" aria-label={messages.outline}>
+        {entries.map(entry => (
+          <div
+            className="gt-outline-row"
+            data-selected={entry.nodeId === selectedNodeId ? 'true' : 'false'}
+            data-level={entry.level}
+            role="treeitem"
+            aria-level={entry.level}
+            aria-selected={entry.nodeId === selectedNodeId}
+            aria-expanded={entry.expanded}
+            tabIndex={0}
+            key={entry.nodeId}
+            onClick={() => onSelect({ nodeId: entry.nodeId, sourceIds: [...entry.sourceIds] })}
+            onKeyDown={event => {
+              if (event.key === 'Enter' || event.key === ' ') {
+                event.preventDefault();
+                onSelect({ nodeId: entry.nodeId, sourceIds: [...entry.sourceIds] });
+              }
+            }}
+          >
+            <span className="gt-row-grip" aria-hidden="true">
+              <GripVertical size={14} />
+            </span>
+            <span className="gt-row-disclosure" aria-hidden="true">
+              {entry.expanded === true ? (
+                <ChevronDown size={15} />
+              ) : entry.expanded === false ? (
+                <ChevronRight size={15} />
+              ) : null}
+            </span>
+            <span className="gt-row-main">
+              <span className="gt-row-label">{entry.label}</span>
+              {entry.groupSize === undefined ? null : (
+                <span className="gt-row-meta">
+                  {entry.groupSize} {messages.groupedItems}
+                </span>
+              )}
+            </span>
+            <span className="gt-row-value">
+              {entry.amount === null
+                ? `${entry.sourceIds.length} ${messages.sourceItems}`
+                : formatAmount(entry.amount, locale, sourceData.currency)}
+            </span>
+            {entry.locked ? (
+              <LockKeyhole className="gt-row-lock" size={13} aria-label={messages.locked} />
+            ) : (
+              <span className="gt-row-lock-placeholder" aria-hidden="true" />
+            )}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
