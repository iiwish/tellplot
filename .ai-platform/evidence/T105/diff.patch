diff --git a/packages/editor/src/components/WaterfallCanvas.tsx b/packages/editor/src/components/WaterfallCanvas.tsx
new file mode 100644
index 0000000..3f76eb2
--- /dev/null
+++ b/packages/editor/src/components/WaterfallCanvas.tsx
@@ -0,0 +1,343 @@
+import type { Chart as G2Chart, G2Spec } from '@antv/g2';
+import { useEffect, useId, useLayoutEffect, useRef, useState } from 'react';

+import type {
+  WaterfallDatum,
+  WaterfallDatumKind,
+  WaterfallProjection,
+} from '../waterfall/waterfallTypes';
+import { formatAmount, type EditorLocale } from './formatAmount';

+const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';
+const MOBILE_VIEWPORT_QUERY = '(max-width: 759px)';
+const CHART_ERROR = { code: 'CHART_RENDER_ERROR', path: '/chart' } as const;
+const COLOR_DOMAIN: readonly WaterfallDatumKind[] = [
+  'start',
+  'positive',
+  'negative',
+  'subtotal',
+  'group',
+  'end',
+];
+const COLOR_RANGE = ['#5F6B65', '#168363', '#D5524A', '#315C8C', '#A46812', '#315C8C'];

+interface ChartCopy {
+  readonly eyebrow: string;
+  readonly title: string;
+  readonly empty: string;
+  readonly summaryLabel: string;
+  readonly visibleNodes: (count: number) => string;
+  readonly summaryIntro: (title: string, count: number) => string;
+  readonly kindLabels: Readonly<Record<WaterfallDatumKind, string>>;
+}

+const CHART_COPY: Readonly<Record<EditorLocale, ChartCopy>> = {
+  'zh-CN': {
+    eyebrow: '财务瀑布图',
+    title: '经营变动瀑布图',
+    empty: '暂无贡献项',
+    summaryLabel: '图表摘要',
+    visibleNodes: count => `${count} 个可见节点`,
+    summaryIntro: (title, count) => `${title}，共 ${count} 个可见节点。`,
+    kindLabels: {
+      start: '起点',
+      positive: '正向贡献',
+      negative: '负向贡献',
+      subtotal: '小计',
+      group: '分组',
+      end: '终点',
+    },
+  },
+  'en-US': {
+    eyebrow: 'Financial waterfall',
+    title: 'Operating bridge',
+    empty: 'No contribution items',
+    summaryLabel: 'Chart summary',
+    visibleNodes: count => `${count} visible nodes`,
+    summaryIntro: (title, count) => `${title}, ${count} visible nodes.`,
+    kindLabels: {
+      start: 'start',
+      positive: 'positive contribution',
+      negative: 'negative contribution',
+      subtotal: 'subtotal',
+      group: 'group',
+      end: 'end',
+    },
+  },
+};

+export interface ChartRenderIssue {
+  readonly code: 'CHART_RENDER_ERROR';
+  readonly path: '/chart';
+}

+export interface WaterfallCanvasProps {
+  readonly projection: WaterfallProjection;
+  readonly title?: string;
+  readonly locale?: EditorLocale;
+  readonly currency?: string | undefined;
+  readonly empty?: boolean;
+  readonly reducedMotion?: boolean;
+  readonly onRenderError?: (issue: ChartRenderIssue | null) => void;
+}

+function formatDatumAmount(datum: WaterfallDatum, locale: EditorLocale, currency?: string): string {
+  const amount = formatAmount(datum.amount, locale, currency);
+  const contribution =
+    datum.kind === 'positive' || datum.kind === 'negative' || datum.kind === 'group';
+  return contribution && datum.amount > 0 ? `+${amount}` : amount;
+}

+function chartSpec(
+  projection: WaterfallProjection,
+  locale: EditorLocale,
+  currency: string | undefined,
+  reducedMotion: boolean,
+  showValueLabels: boolean,
+): G2Spec {
+  const labelById = new Map(projection.map(datum => [datum.nodeId, datum.label]));

+  return {
+    type: 'view',
+    labelTransform: [{ type: 'overlapHide' }],
+    children: [
+      {
+        type: 'interval',
+        data: [...projection],
+        encode: {
+          x: 'nodeId',
+          y: ['start', 'end'],
+          color: 'kind',
+          key: 'nodeId',
+        },
+        scale: {
+          x: { type: 'band', padding: 0.24 },
+          y: { type: 'linear', nice: true, zero: true },
+          color: {
+            type: 'ordinal',
+            domain: [...COLOR_DOMAIN],
+            range: COLOR_RANGE,
+          },
+        },
+        axis: {
+          x: {
+            title: false,
+            labelAutoHide: true,
+            labelAutoRotate: false,
+            labelFormatter: (value: unknown) => labelById.get(String(value)) ?? String(value),
+          },
+          y: {
+            title: false,
+            labelFormatter: (value: unknown) => formatAmount(Number(value), locale, currency),
+          },
+        },
+        legend: { color: false },
+        labels: showValueLabels
+          ? [
+              {
+                text: (datum: WaterfallDatum) => formatDatumAmount(datum, locale, currency),
+                position: (datum: WaterfallDatum) => (datum.end >= datum.start ? 'top' : 'bottom'),
+                style: {
+                  fill: '#34403A',
+                  fontSize: 11,
+                  fontWeight: 600,
+                },
+              },
+            ]
+          : [],
+        style: {
+          fillOpacity: 0.96,
+          insetLeft: 3,
+          insetRight: 3,
+          lineWidth: 1,
+          stroke: '#FFFFFF',
+        },
+        tooltip: false,
+        animate: reducedMotion
+          ? false
+          : {
+              enter: { type: 'growInY', duration: 160, easing: 'ease-out' },
+              update: { type: 'morphing', duration: 160, easing: 'ease-out' },
+              exit: { type: 'fadeOut', duration: 120, easing: 'ease-out' },
+            },
+      },
+    ],
+  };
+}

+function useMediaQuery(query: string): boolean {
+  const [matches, setMatches] = useState(() =>
+    typeof window !== 'undefined' && typeof window.matchMedia === 'function'
+      ? window.matchMedia(query).matches
+      : false,
+  );

+  useEffect(() => {
+    if (typeof window === 'undefined' || typeof window.matchMedia !== 'function') {
+      return undefined;
+    }

+    const mediaQuery = window.matchMedia(query);
+    const handleChange = (event: MediaQueryListEvent): void => {
+      setMatches(event.matches);
+    };
+    mediaQuery.addEventListener('change', handleChange);

+    return () => {
+      mediaQuery.removeEventListener('change', handleChange);
+    };
+  }, [query]);

+  return matches;
+}

+function notifyRenderIssue(
+  callback: WaterfallCanvasProps['onRenderError'],
+  issue: ChartRenderIssue | null,
+): void {
+  if (callback === undefined) {
+    return;
+  }

+  try {
+    callback(issue);
+  } catch {
+    console.error('g2touch callback failed: onRenderError');
+  }
+}

+/** Owns the real G2 canvas lifecycle for one immutable waterfall projection. */
+export function WaterfallCanvas({
+  projection,
+  title,
+  locale = 'zh-CN',
+  currency,
+  empty,
+  reducedMotion,
+  onRenderError,
+}: WaterfallCanvasProps): React.JSX.Element {
+  const hostRef = useRef<HTMLDivElement>(null);
+  const generationRef = useRef(0);
+  const onRenderErrorRef = useRef(onRenderError);
+  const [renderFailure, setRenderFailure] = useState<{
+    readonly projection: WaterfallProjection;
+    readonly issue: ChartRenderIssue;
+  } | null>(null);
+  const titleId = useId();
+  const systemReducedMotion = useMediaQuery(REDUCED_MOTION_QUERY);
+  const mobileViewport = useMediaQuery(MOBILE_VIEWPORT_QUERY);
+  const isEmpty =
+    empty ??
+    !projection.some(
+      datum => datum.kind === 'positive' || datum.kind === 'negative' || datum.kind === 'group',
+    );
+  const shouldReduceMotion = reducedMotion ?? systemReducedMotion;
+  const renderIssue = renderFailure?.projection === projection ? renderFailure.issue : null;
+  const copy = CHART_COPY[locale];
+  const visibleTitle = title ?? copy.title;

+  useLayoutEffect(() => {
+    onRenderErrorRef.current = onRenderError;
+  }, [onRenderError]);

+  useLayoutEffect(() => {
+    const generation = generationRef.current + 1;
+    generationRef.current = generation;
+    let chart: G2Chart | undefined;
+    let destroyed = false;
+    let disposed = false;

+    const destroyChart = (): void => {
+      if (chart === undefined || destroyed) {
+        return;
+      }
+      destroyed = true;
+      try {
+        chart.destroy();
+      } catch {
+        console.error('g2touch chart cleanup failed at /chart');
+      }
+    };

+    const reportFailure = (): void => {
+      if (disposed || generationRef.current !== generation) {
+        return;
+      }
+      destroyChart();
+      console.error('g2touch chart render failed: CHART_RENDER_ERROR /chart');
+      setRenderFailure({ projection, issue: CHART_ERROR });
+      notifyRenderIssue(onRenderErrorRef.current, CHART_ERROR);
+    };

+    const initializeChart = async (): Promise<void> => {
+      const host = hostRef.current;
+      if (host === null) {
+        throw new Error('Chart host is unavailable');
+      }

+      const { Chart } = await import('@antv/g2');
+      if (disposed || generationRef.current !== generation) {
+        return;
+      }

+      chart = new Chart({ container: host, autoFit: true });
+      chart.options(chartSpec(projection, locale, currency, shouldReduceMotion, !mobileViewport));
+      await chart.render();
+      if (disposed || generationRef.current !== generation) {
+        return;
+      }
+      setRenderFailure(null);
+      notifyRenderIssue(onRenderErrorRef.current, null);
+    };

+    void initializeChart().catch(() => {
+      reportFailure();
+    });

+    return () => {
+      disposed = true;
+      destroyChart();
+    };
+  }, [currency, locale, mobileViewport, projection, shouldReduceMotion]);

+  return (
+    <section aria-labelledby={titleId} className="gt-chart-stage" data-testid="g2touch-chart-stage">
+      <header className="gt-chart-stage__header">
+        <div>
+          <p className="gt-chart-stage__eyebrow">{copy.eyebrow}</p>
+          <h2 className="gt-chart-stage__title" id={titleId}>
+            {visibleTitle}
+          </h2>
+        </div>
+        <span className="gt-chart-stage__count">{copy.visibleNodes(projection.length)}</span>
+      </header>

+      {isEmpty ? <p className="gt-chart-stage__empty">{copy.empty}</p> : null}
+      {renderIssue === null ? null : (
+        <div className="gt-chart-stage__error" role="alert">
+          <strong>{renderIssue.code}</strong>
+          <code>{renderIssue.path}</code>
+        </div>
+      )}

+      <div
+        aria-hidden="true"
+        className="gt-chart-stage__plot"
+        data-testid="g2touch-chart"
+        ref={hostRef}
+      />

+      <section aria-label={copy.summaryLabel} className="gt-visually-hidden" role="region">
+        <p>{copy.summaryIntro(visibleTitle, projection.length)}</p>
+        <ol>
+          {projection.map(datum => (
+            <li key={datum.nodeId}>
+              {datum.label}, {copy.kindLabels[datum.kind]},{' '}
+              {formatDatumAmount(datum, locale, currency)}
+            </li>
+          ))}
+        </ol>
+      </section>
+    </section>
+  );
+}
