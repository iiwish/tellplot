+      rootOrder: ['outer-group'],
+      groups: {
+        ...view.groups,
+        'outer-group': {
+          id: 'outer-group',
+          label: 'Outer group',
+          childIds: ['unsafe-group', 'tail'],
+        },
+      },
+    };
+    expect(projectCategorical(source, nestedView)).toEqual(expectedFailure);
+  });
+});
