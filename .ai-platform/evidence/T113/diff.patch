+interface IntervalSpecView {
+  readonly type?: unknown;
+  readonly data?: readonly unknown[];
+  readonly coordinate?: unknown;
+  readonly encode?: Readonly<Record<string, unknown>>;
+  readonly scale?: {
+    readonly x?: Readonly<Record<string, unknown>>;
