+    expect(
+      screen
+        .getAllByRole('treeitem')
+        .filter(row => row.getAttribute('aria-level') === '1')
+        .map(row => row.getAttribute('data-node-id')),
+    ).toEqual(['start', 'a', 'c', 'b', 'subtotal', 'd', 'e', 'end']);
