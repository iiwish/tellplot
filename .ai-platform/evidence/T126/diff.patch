-      return publicFailure(failure('INVALID_TYPE', '/baseRevision').issue, id.value);
-    }
-
-    return {
-      ok: true,
-      value: {
-        id: id.value,
-        source: rawSource as CommandSource,
-        baseRevision: baseRevision as number,
-      },
-    };
-  } catch {
-    return publicFailure(failure('UNREADABLE_INPUT', '/').issue, commandId);
-  }
-}
