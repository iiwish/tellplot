-  if (typeof value !== 'string') {
-    errors.push(validationIssue(code, 'INVALID_TYPE', '/schemaVersion'));
-    return undefined;
-  }
-  if (value !== '1.0.0' && value !== '2.0.0') {
-    errors.push(
-      validationIssue('UNSUPPORTED_SCHEMA_VERSION', 'UNSUPPORTED_SCHEMA_VERSION', '/schemaVersion'),
-    );
