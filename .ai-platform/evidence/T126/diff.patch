-function validateMovableNode(
-  session: EditorSession,
-  commandId: string,
-  nodeId: ViewNodeId,
-  path: string,
-  expected: 'item' | 'group',
-): ApplyFailure | { readonly ok: true } {
-  if (expected === 'item') {
-    const result = validateMovableItem(session, commandId, nodeId as SourceItemId, path);
-    return result.ok ? { ok: true } : result;
-  }
