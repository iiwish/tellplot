+  throw new Error('Vue matrix host is missing');
+}
+
+const appearance = ref(undefined);
+const app = createApp({
+  setup() {
+    return () =>
+      h(ChartEditor, {
+        config: { ...baseConfig, appearance: appearance.value },
+      });
+  },
+});
+app.mount(host);
+
+globalThis.__tellplotFrameworkMatrix = {
+  configure() {
+    appearance.value = {
+      title: 'Configured bridge',
+      colors: {
+        start: '#d946ef',
+        positive: '#d946ef',
+        negative: '#d946ef',
+        subtotal: '#d946ef',
+        group: '#d946ef',
+        end: '#d946ef',
+      },
+      axes: { category: false, value: true },
+      labels: { value: 'never' },
+      tooltip: true,
+      animation: { enabled: false, duration: 0 },
+      numberFormat: {
+        minimumFractionDigits: 1,
+        maximumFractionDigits: 1,
+        currencyDisplay: 'code',
+      },
+    };
+  },
+  frameworkVersion: version,
+  unmount() {
+    app.unmount();
+    host.dataset.unmounted = 'true';
+  },
+};
diff --git a/packages/editor/tests/runtime/editor.test.ts b/packages/editor/tests/runtime/editor.test.ts
