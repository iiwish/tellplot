+import { describe, expect, it } from 'vitest';
+
+import {
+  createEditorSession,
+  createInitialViewSpec,
+  parseViewSpec,
+  serializeViewSpec,
+  validateSourceData,
+  validateViewSpec,
+  type CategoricalSourceData,
+  type InitialViewSpecOptions,
