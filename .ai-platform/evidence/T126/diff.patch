+declare const idBrand: unique symbol;
+
+type BrandedId<TName extends string> = string & {
+  readonly [idBrand]?: TName;
+};
+
+export type DatasetId = BrandedId<'DatasetId'>;
+export type SourceItemId = BrandedId<'SourceItemId'>;
+export type GroupId = BrandedId<'GroupId'>;
+export type ViewNodeId = SourceItemId | GroupId;
diff --git a/packages/core/src/domain/invariants.ts b/packages/core/src/domain/invariants.ts
new file mode 100644
index 0000000..e50cb06
--- /dev/null
+++ b/packages/core/src/domain/invariants.ts
@@ -0,0 +1,11 @@
+import type { ValidationResult } from './errors';
+import type { SourceData, ViewSpec } from './model';
+import { validateViewSpec } from './validation';
+
+/** Applies the canonical ViewSpec validator as the command commit invariant gate. */
+export function validateEditorInvariants(
+  sourceData: SourceData,
+  viewSpec: ViewSpec,
+): ValidationResult<ViewSpec> {
+  return validateViewSpec(viewSpec, sourceData);
+}
