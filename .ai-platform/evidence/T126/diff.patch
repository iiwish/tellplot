+
+function baseView(): ViewSpec {
+  return {
+    schemaVersion: '1.0.0',
+    datasetId: sourceData.datasetId,
+    chartType: 'waterfall',
+    revision: 0,
+    rootOrder: ['inner', 'c', 'd'],
+    groups: {
+      inner: { id: 'inner', label: 'Inner', childIds: ['a', 'b'] },
+    },
+    collapsedGroupIds: ['inner'],
+    pinnedItemIds: [],
+    annotations: {},
+    emphasis: {},
