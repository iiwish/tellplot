+describe('playground chart document', () => {
+  it('round-trips the complete chart state with deterministic two-space JSON', () => {
+    const text = serializePlaygroundChartDocument(documentFixture);
+    const result = parsePlaygroundChartDocument(text);
+
+    expect(text).toBe(`${JSON.stringify(documentFixture, null, 2)}\n`);
+    expect(result).toEqual({ ok: true, value: documentFixture });
+  });
+
+  it('prefixes source and view validation paths', () => {
+    const invalidSource = JSON.stringify({
+      ...documentFixture,
+      sourceData: { ...documentFixture.sourceData, datasetId: '' },
+    });
+    const sourceResult = parsePlaygroundChartDocument(invalidSource);
+    expect(sourceResult).toMatchObject({
+      ok: false,
+      error: { code: 'INVALID_SOURCE_DATA', path: '/sourceData/datasetId' },
+    });
+
+    const invalidView = JSON.stringify({
+      ...documentFixture,
+      viewSpec: { ...documentFixture.viewSpec, rootOrder: ['missing'] },
+    });
+    const viewResult = parsePlaygroundChartDocument(invalidView);
+    expect(viewResult).toMatchObject({
+      ok: false,
+      error: { code: 'SOURCE_CONFLICT', path: '/viewSpec/rootOrder/0' },
+    });
+  });
+
+  it('rejects malformed JSON, unknown fields and unsafe appearance values', () => {
+    expect(parsePlaygroundChartDocument('{')).toMatchObject({
+      ok: false,
+      error: { code: 'INVALID_JSON', path: '/' },
+    });
+    expect(
+      parsePlaygroundChartDocument(JSON.stringify({ ...documentFixture, execute: 'alert(1)' })),
+    ).toMatchObject({
+      ok: false,
+      error: { code: 'UNKNOWN_FIELD', path: '/execute' },
+    });
+    expect(
+      parsePlaygroundChartDocument(
+        JSON.stringify({
+          ...documentFixture,
+          chartAppearance: {
+            ...documentFixture.chartAppearance,
+            animation: { enabled: true, duration: 'fast' },
+          },
+        }),
+      ),
+    ).toMatchObject({
+      ok: false,
+      error: { code: 'INVALID_TYPE', path: '/chartAppearance/animation/duration' },
+    });
+  });
+
+  it('requires closed panel and layout values', () => {
+    expect(
+      parsePlaygroundChartDocument(
+        JSON.stringify({ ...documentFixture, panels: { outline: 'yes' } }),
+      ),
+    ).toMatchObject({
+      ok: false,
+      error: { code: 'INVALID_TYPE', path: '/panels/outline' },
+    });
+    expect(
+      parsePlaygroundChartDocument(
+        JSON.stringify({
+          ...documentFixture,
+          layout: { outlinePlacement: 'center', inspectorMode: 'tab' },
+        }),
+      ),
+    ).toMatchObject({
+      ok: false,
+      error: { code: 'INVALID_VALUE', path: '/layout/outlinePlacement' },
+    });
+  });
+});
