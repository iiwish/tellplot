+
+const GUIDE_TABS = [
+  {
+    id: 'install',
+    label: '安装',
+    icon: PackageOpen,
+    code: INSTALL_CODE,
+    copyLabel: '复制安装命令',
+  },
+  {
+    id: 'react',
+    label: 'React',
+    icon: Braces,
+    code: REACT_CODE,
+    copyLabel: '复制 React 代码',
+  },
+  {
+    id: 'appearance',
+    label: '配置',
+    icon: SlidersHorizontal,
+    code: APPEARANCE_CODE,
+    copyLabel: '复制配置代码',
+  },
+] as const;
+
+type GuideTabId = (typeof GUIDE_TABS)[number]['id'];
+type DeveloperView = 'live' | 'examples';
+type CopyState = 'idle' | 'copied' | 'failed';
+
+interface UsageGuideProps {
+  readonly id: string;
+  readonly variant: 'panel' | 'dialog';
+  readonly document: PlaygroundChartDocument | null;
+  readonly onApplyDocument: (document: PlaygroundChartDocument) => void;
+  readonly onClose: () => void;
+}
+
+export function UsageGuide({
+  id,
+  variant,
+  document,
+  onApplyDocument,
+  onClose,
+}: UsageGuideProps): React.JSX.Element {
+  const [developerView, setDeveloperView] = useState<DeveloperView>('live');
+  const [activeTab, setActiveTab] = useState<GuideTabId>('install');
+  const [copyState, setCopyState] = useState<CopyState>('idle');
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const closeButtonRef = useRef<HTMLButtonElement>(null);
+  const tabRefs = useRef<(HTMLButtonElement | null)[]>([]);
+  const developerViewRefs = useRef<(HTMLButtonElement | null)[]>([]);
+  const copyResetRef = useRef<number | undefined>(undefined);
+  const selectedTab = GUIDE_TABS.find(tab => tab.id === activeTab) ?? GUIDE_TABS[0];
+
+  useEffect(() => {
+    if (variant !== 'dialog') {
+      return undefined;
+    }
+    const dialog = dialogRef.current;
+    if (dialog === null) {
+      return undefined;
+    }
+    dialog.showModal();
+    const focusFrame = window.requestAnimationFrame(() => closeButtonRef.current?.focus());
+    return () => {
+      window.cancelAnimationFrame(focusFrame);
+      if (dialog.open) {
+        dialog.close();
+      }
+    };
+  }, [variant]);
+
+  useEffect(
+    () => () => {
+      if (copyResetRef.current !== undefined) {
+        window.clearTimeout(copyResetRef.current);
+      }
+    },
+    [],
+  );
+
+  const selectTab = (tabId: GuideTabId): void => {
+    setActiveTab(tabId);
+    setCopyState('idle');
+  };
+
+  const selectDeveloperView = (view: DeveloperView): void => {
+    setDeveloperView(view);
+    setCopyState('idle');
+  };
+
+  const navigateDeveloperViews = (
+    event: React.KeyboardEvent<HTMLButtonElement>,
+    index: number,
+  ): void => {
+    const views: readonly DeveloperView[] = ['live', 'examples'];
+    let target: number | undefined;
+    if (event.key === 'ArrowRight') {
+      target = (index + 1) % views.length;
+    } else if (event.key === 'ArrowLeft') {
+      target = (index - 1 + views.length) % views.length;
+    } else if (event.key === 'Home') {
+      target = 0;
+    } else if (event.key === 'End') {
+      target = views.length - 1;
+    }
+    if (target === undefined) {
+      return;
+    }
+    event.preventDefault();
+    const view = views[target];
+    if (view !== undefined) {
+      selectDeveloperView(view);
+      developerViewRefs.current[target]?.focus();
+    }
+  };
+
+  const navigateTabs = (event: React.KeyboardEvent<HTMLButtonElement>, index: number): void => {
+    let target: number | undefined;
+    if (event.key === 'ArrowRight') {
+      target = (index + 1) % GUIDE_TABS.length;
+    } else if (event.key === 'ArrowLeft') {
+      target = (index - 1 + GUIDE_TABS.length) % GUIDE_TABS.length;
+    } else if (event.key === 'Home') {
+      target = 0;
+    } else if (event.key === 'End') {
+      target = GUIDE_TABS.length - 1;
+    }
+    if (target === undefined) {
+      return;
+    }
+    event.preventDefault();
+    const tab = GUIDE_TABS[target];
+    if (tab !== undefined) {
+      selectTab(tab.id);
+      tabRefs.current[target]?.focus();
+    }
+  };
+
+  const copySelectedCode = async (): Promise<void> => {
+    if (copyResetRef.current !== undefined) {
+      window.clearTimeout(copyResetRef.current);
+    }
+    try {
+      await writeClipboard(selectedTab.code);
+      setCopyState('copied');
+    } catch {
+      setCopyState('failed');
+    }
+    copyResetRef.current = window.setTimeout(() => setCopyState('idle'), 1800);
+  };
+
+  const content = (
+    <div className="playground-usage-content">
+      <header className="playground-usage-header">
+        <div>
+          <h2 id={`${id}-title`}>在项目中使用 TellPlot</h2>
+          <code>{developerView === 'live' ? 'tellplot.config.json' : '@tellplot/editor'}</code>
+        </div>
+        <button
+          ref={closeButtonRef}
+          className="playground-icon-button"
+          type="button"
+          aria-label="关闭使用说明"
+          title="关闭"
+          onClick={onClose}
+        >
+          <X size={18} aria-hidden="true" />
+        </button>
+      </header>
+
+      <div className="playground-developer-tabs" role="tablist" aria-label="开发者工具">
+        {(
+          [
+            { id: 'live', label: '实时配置', icon: FileJson2 },
+            { id: 'examples', label: '接入示例', icon: Braces },
+          ] as const
+        ).map((view, index) => {
+          const Icon = view.icon;
+          const selected = view.id === developerView;
+          return (
+            <button
+              key={view.id}
+              ref={element => {
+                developerViewRefs.current[index] = element;
+              }}
+              id={`${id}-developer-tab-${view.id}`}
+              type="button"
+              role="tab"
+              aria-selected={selected}
+              aria-controls={`${id}-developer-panel-${view.id}`}
+              tabIndex={selected ? 0 : -1}
+              onClick={() => selectDeveloperView(view.id)}
+              onKeyDown={event => navigateDeveloperViews(event, index)}
+            >
+              <Icon size={16} aria-hidden="true" />
+              <span>{view.label}</span>
+            </button>
+          );
+        })}
+      </div>
+
+      {developerView === 'live' ? (
+        <LiveChartEditor
+          id={`${id}-developer-panel-live`}
+          labelledBy={`${id}-developer-tab-live`}
+          document={document}
+          onApply={onApplyDocument}
+        />
+      ) : (
+        <section
+          id={`${id}-developer-panel-examples`}
+          className="playground-usage-examples"
+          role="tabpanel"
+          aria-labelledby={`${id}-developer-tab-examples`}
+        >
+          <div className="playground-usage-tabs" role="tablist" aria-label="使用方式">
+            {GUIDE_TABS.map((tab, index) => {
+              const Icon = tab.icon;
+              const selected = tab.id === activeTab;
+              return (
+                <button
+                  key={tab.id}
+                  ref={element => {
+                    tabRefs.current[index] = element;
+                  }}
+                  id={`${id}-tab-${tab.id}`}
+                  type="button"
+                  role="tab"
+                  aria-selected={selected}
+                  aria-controls={`${id}-panel-${tab.id}`}
+                  tabIndex={selected ? 0 : -1}
+                  onClick={() => selectTab(tab.id)}
+                  onKeyDown={event => navigateTabs(event, index)}
+                >
+                  <Icon size={16} aria-hidden="true" />
+                  <span>{tab.label}</span>
+                </button>
+              );
+            })}
+          </div>
+          <section
+            id={`${id}-panel-${selectedTab.id}`}
+            className="playground-code-panel"
+            role="tabpanel"
+            aria-labelledby={`${id}-tab-${selectedTab.id}`}
+            tabIndex={0}
+          >
+            <div className="playground-code-panel__toolbar">
+              <span>{selectedTab.label}</span>
+              <div className="playground-copy-control">
+                <span
+                  className="playground-copy-status"
+                  role="status"
+                  aria-label="代码复制状态"
+                  aria-live="polite"
+                >
+                  {copyState === 'copied' ? '已复制' : copyState === 'failed' ? '复制失败' : ''}
+                </span>
+                <button
+                  className="playground-icon-button playground-icon-button--code"
+                  type="button"
+                  aria-label={selectedTab.copyLabel}
+                  title={selectedTab.copyLabel}
+                  onClick={() => void copySelectedCode()}
+                >
+                  {copyState === 'copied' ? (
+                    <Check size={17} aria-hidden="true" />
+                  ) : (
+                    <Copy size={17} aria-hidden="true" />
+                  )}
+                </button>
+              </div>
+            </div>
+            <pre tabIndex={0} aria-label={`${selectedTab.label}代码`}>
+              <code>{selectedTab.code}</code>
+            </pre>
+          </section>
+        </section>
+      )}
+    </div>
+  );
+
+  if (variant === 'panel') {
+    return (
+      <aside id={id} className="playground-usage-sidebar" aria-labelledby={`${id}-title`}>
+        {content}
+      </aside>
+    );
+  }
+
+  return (
+    <dialog
+      id={id}
+      ref={dialogRef}
+      className="playground-usage-dialog"
+      aria-labelledby={`${id}-title`}
+      onCancel={event => {
+        event.preventDefault();
+        onClose();
+      }}
+      onClick={event => {
+        if (event.target === event.currentTarget) {
+          onClose();
+        }
+      }}
+    >
+      {content}
+    </dialog>
+  );
+}
diff --git a/apps/playground/src/chartDocument.ts b/apps/playground/src/chartDocument.ts
new file mode 100644
index 0000000..ea25d83
--- /dev/null
+++ b/apps/playground/src/chartDocument.ts
@@ -0,0 +1,415 @@
+import {
+  validateSourceData,
+  validateViewSpec,
+  type FinancialChartAppearance,
+  type FinancialChartEditorLayout,
+  type FinancialChartEditorPanels,
+  type SourceData,
+  type ValidationErrorCode,
+  type ViewSpec,
+} from '@tellplot/editor';
+
+export const PLAYGROUND_CHART_DOCUMENT_VERSION = '1.0' as const;
+
+export interface PlaygroundChartDocument {
+  readonly documentVersion: typeof PLAYGROUND_CHART_DOCUMENT_VERSION;
+  readonly sourceData: SourceData;
+  readonly viewSpec: ViewSpec;
+  readonly chartAppearance: FinancialChartAppearance;
+  readonly panels: FinancialChartEditorPanels;
+  readonly layout: FinancialChartEditorLayout;
+}
+
+export interface PlaygroundChartDocumentError {
+  readonly code:
+    | 'INVALID_JSON'
+    | 'INVALID_DOCUMENT'
+    | 'UNKNOWN_FIELD'
+    | 'INVALID_TYPE'
+    | 'INVALID_VALUE'
+    | 'INVALID_SOURCE_DATA'
+    | 'INVALID_VIEW_SPEC'
+    | 'SOURCE_CONFLICT'
+    | ValidationErrorCode;
+  readonly path: string;
+}
+
+export type PlaygroundChartDocumentResult =
+  | { readonly ok: true; readonly value: PlaygroundChartDocument }
+  | { readonly ok: false; readonly error: PlaygroundChartDocumentError };
+
+type UnknownRecord = Record<string, unknown>;
+type PlaygroundChartDocumentFailure = Extract<
+  PlaygroundChartDocumentResult,
+  { readonly ok: false }
+>;
+
+const DOCUMENT_FIELDS = [
+  'documentVersion',
+  'sourceData',
+  'viewSpec',
+  'chartAppearance',
+  'panels',
+  'layout',
+] as const;
+const APPEARANCE_FIELDS = [
+  'title',
+  'palette',
+  'axis',
+  'valueLabels',
+  'tooltip',
+  'animation',
+  'groupRegion',
+  'numberFormat',
+] as const;
+const PALETTE_FIELDS = ['start', 'positive', 'negative', 'subtotal', 'group', 'end'] as const;
+const AXIS_FIELDS = ['x', 'y'] as const;
+const ANIMATION_FIELDS = ['enabled', 'duration'] as const;
+const GROUP_REGION_FIELDS = ['enabled', 'fillOpacity', 'label'] as const;
+const NUMBER_FORMAT_FIELDS = [
+  'minimumFractionDigits',
+  'maximumFractionDigits',
+  'currencyDisplay',
+] as const;
+const PANEL_FIELDS = ['outline', 'inspector', 'toolbar'] as const;
+const LAYOUT_FIELDS = ['outlinePlacement', 'inspectorMode'] as const;
+const HEX_COLOR_PATTERN = /^#(?:[0-9A-F]{3}|[0-9A-F]{4}|[0-9A-F]{6}|[0-9A-F]{8})$/iu;
+
+function failure(
+  code: PlaygroundChartDocumentError['code'],
+  path: string,
+): PlaygroundChartDocumentFailure {
+  return { ok: false, error: { code, path } };
+}
+
+function isRecord(value: unknown): value is UnknownRecord {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function firstUnknownField(
+  value: UnknownRecord,
+  fields: readonly string[],
+  path: string,
+): PlaygroundChartDocumentFailure | undefined {
+  const allowed = new Set(fields);
+  const unknown = Object.keys(value).find(key => !allowed.has(key));
+  return unknown === undefined ? undefined : failure('UNKNOWN_FIELD', `${path}/${unknown}`);
+}
+
+function recordAt(
+  value: unknown,
+  path: string,
+  fields: readonly string[],
+): { readonly ok: true; readonly value: UnknownRecord } | PlaygroundChartDocumentFailure {
+  if (!isRecord(value)) {
+    return failure('INVALID_TYPE', path);
+  }
+  const unknown = firstUnknownField(value, fields, path === '/' ? '' : path);
+  return unknown ?? { ok: true, value };
+}
+
+function optionalBoolean(
+  record: UnknownRecord,
+  key: string,
+  path: string,
+): PlaygroundChartDocumentFailure | undefined {
+  const value = record[key];
+  return value === undefined || typeof value === 'boolean'
+    ? undefined
+    : failure('INVALID_TYPE', `${path}/${key}`);
+}
+
+function optionalEnum(
+  record: UnknownRecord,
+  key: string,
+  values: readonly string[],
+  path: string,
+): PlaygroundChartDocumentFailure | undefined {
+  const value = record[key];
+  if (value === undefined) {
+    return undefined;
+  }
+  return typeof value === 'string' && values.includes(value)
+    ? undefined
+    : failure(typeof value === 'string' ? 'INVALID_VALUE' : 'INVALID_TYPE', `${path}/${key}`);
+}
+
+function optionalFiniteNumber(
+  record: UnknownRecord,
+  key: string,
+  path: string,
+  minimum: number,
+  maximum: number,
+  integer = false,
+): PlaygroundChartDocumentFailure | undefined {
+  const value = record[key];
+  if (value === undefined) {
+    return undefined;
+  }
+  if (typeof value !== 'number' || !Number.isFinite(value)) {
+    return failure('INVALID_TYPE', `${path}/${key}`);
+  }
+  return value < minimum || value > maximum || (integer && !Number.isInteger(value))
+    ? failure('INVALID_VALUE', `${path}/${key}`)
+    : undefined;
+}
+
+function validateAppearance(input: unknown): PlaygroundChartDocumentFailure | undefined {
+  const appearanceResult = recordAt(input, '/chartAppearance', APPEARANCE_FIELDS);
+  if (!appearanceResult.ok) {
+    return appearanceResult;
+  }
+  const appearance = appearanceResult.value;
+  const title = appearance['title'];
+  if (title !== undefined && (typeof title !== 'string' || title.trim() === '')) {
+    return failure(
+      typeof title === 'string' ? 'INVALID_VALUE' : 'INVALID_TYPE',
+      '/chartAppearance/title',
+    );
+  }
+  const valueLabels = optionalEnum(
+    appearance,
+    'valueLabels',
+    ['auto', 'always', 'never'],
+    '/chartAppearance',
+  );
+  if (valueLabels !== undefined) {
+    return valueLabels;
+  }
+  const tooltip = optionalBoolean(appearance, 'tooltip', '/chartAppearance');
+  if (tooltip !== undefined) {
+    return tooltip;
+  }
+
+  const paletteInput = appearance['palette'];
+  if (paletteInput !== undefined) {
+    const paletteResult = recordAt(paletteInput, '/chartAppearance/palette', PALETTE_FIELDS);
+    if (!paletteResult.ok) {
+      return paletteResult;
+    }
+    for (const key of PALETTE_FIELDS) {
+      const color = paletteResult.value[key];
+      if (color !== undefined && (typeof color !== 'string' || !HEX_COLOR_PATTERN.test(color))) {
+        return failure(
+          typeof color === 'string' ? 'INVALID_VALUE' : 'INVALID_TYPE',
+          `/chartAppearance/palette/${key}`,
+        );
+      }
+    }
+  }
+
+  const axisInput = appearance['axis'];
+  if (axisInput !== undefined) {
+    const axisResult = recordAt(axisInput, '/chartAppearance/axis', AXIS_FIELDS);
+    if (!axisResult.ok) {
+      return axisResult;
+    }
+    for (const key of AXIS_FIELDS) {
+      const issue = optionalBoolean(axisResult.value, key, '/chartAppearance/axis');
+      if (issue !== undefined) {
+        return issue;
+      }
+    }
+  }
+
+  const animationInput = appearance['animation'];
+  if (animationInput !== undefined) {
+    const animationResult = recordAt(
+      animationInput,
+      '/chartAppearance/animation',
+      ANIMATION_FIELDS,
+    );
+    if (!animationResult.ok) {
+      return animationResult;
+    }
+    const enabled = optionalBoolean(animationResult.value, 'enabled', '/chartAppearance/animation');
+    if (enabled !== undefined) {
+      return enabled;
+    }
+    const duration = optionalFiniteNumber(
+      animationResult.value,
+      'duration',
+      '/chartAppearance/animation',
+      0,
+      1_000,
+      true,
+    );
+    if (duration !== undefined) {
+      return duration;
+    }
+  }
+
+  const groupRegionInput = appearance['groupRegion'];
+  if (groupRegionInput !== undefined) {
+    const groupRegionResult = recordAt(
+      groupRegionInput,
+      '/chartAppearance/groupRegion',
+      GROUP_REGION_FIELDS,
+    );
+    if (!groupRegionResult.ok) {
+      return groupRegionResult;
+    }
+    const enabled = optionalBoolean(
+      groupRegionResult.value,
+      'enabled',
+      '/chartAppearance/groupRegion',
+    );
+    if (enabled !== undefined) {
+      return enabled;
+    }
+    const opacity = optionalFiniteNumber(
+      groupRegionResult.value,
+      'fillOpacity',
+      '/chartAppearance/groupRegion',
+      0,
+      0.2,
+    );
+    if (opacity !== undefined) {
+      return opacity;
+    }
+    const label = optionalEnum(
+      groupRegionResult.value,
+      'label',
+      ['auto', 'never'],
+      '/chartAppearance/groupRegion',
+    );
+    if (label !== undefined) {
+      return label;
+    }
+  }
+
+  const numberFormatInput = appearance['numberFormat'];
+  if (numberFormatInput !== undefined) {
+    const numberFormatResult = recordAt(
+      numberFormatInput,
+      '/chartAppearance/numberFormat',
+      NUMBER_FORMAT_FIELDS,
+    );
+    if (!numberFormatResult.ok) {
+      return numberFormatResult;
+    }
+    for (const key of ['minimumFractionDigits', 'maximumFractionDigits'] as const) {
+      const issue = optionalFiniteNumber(
+        numberFormatResult.value,
+        key,
+        '/chartAppearance/numberFormat',
+        0,
+        6,
+        true,
+      );
+      if (issue !== undefined) {
+        return issue;
+      }
+    }
+    const currencyDisplay = optionalEnum(
+      numberFormatResult.value,
+      'currencyDisplay',
+      ['symbol', 'narrowSymbol', 'code', 'name'],
+      '/chartAppearance/numberFormat',
+    );
+    if (currencyDisplay !== undefined) {
+      return currencyDisplay;
+    }
+    const minimum = numberFormatResult.value['minimumFractionDigits'];
+    const maximum = numberFormatResult.value['maximumFractionDigits'];
+    if (typeof minimum === 'number' && typeof maximum === 'number' && maximum < minimum) {
+      return failure('INVALID_VALUE', '/chartAppearance/numberFormat/maximumFractionDigits');
+    }
+  }
+  return undefined;
+}
+
+function validatePanels(input: unknown): PlaygroundChartDocumentFailure | undefined {
+  const result = recordAt(input, '/panels', PANEL_FIELDS);
+  if (!result.ok) {
+    return result;
+  }
+  for (const key of PANEL_FIELDS) {
+    const issue = optionalBoolean(result.value, key, '/panels');
+    if (issue !== undefined) {
+      return issue;
+    }
+  }
+  return undefined;
+}
+
+function validateLayout(input: unknown): PlaygroundChartDocumentFailure | undefined {
+  const result = recordAt(input, '/layout', LAYOUT_FIELDS);
+  if (!result.ok) {
+    return result;
+  }
+  return (
+    optionalEnum(result.value, 'outlinePlacement', ['left', 'right'], '/layout') ??
+    optionalEnum(result.value, 'inspectorMode', ['static', 'tab'], '/layout')
+  );
+}
+
+function prefixPath(prefix: string, path: string): string {
+  return path === '/' ? prefix : `${prefix}${path}`;
+}
+
+/** Serializes the playground-only document without introducing a package persistence contract. */
+export function serializePlaygroundChartDocument(document: PlaygroundChartDocument): string {
+  return `${JSON.stringify(document, null, 2)}\n`;
+}
+
+/** Parses a safe JSON chart document and delegates source/view invariants to the public validators. */
+export function parsePlaygroundChartDocument(text: string): PlaygroundChartDocumentResult {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text) as unknown;
+  } catch {
+    return failure('INVALID_JSON', '/');
+  }
+
+  const documentResult = recordAt(parsed, '/', DOCUMENT_FIELDS);
+  if (!documentResult.ok) {
+    return documentResult;
+  }
+  const document = documentResult.value;
+  for (const field of DOCUMENT_FIELDS) {
+    if (!(field in document)) {
+      return failure('INVALID_DOCUMENT', `/${field}`);
+    }
+  }
+  if (document['documentVersion'] !== PLAYGROUND_CHART_DOCUMENT_VERSION) {
+    return failure(
+      typeof document['documentVersion'] === 'string' ? 'INVALID_VALUE' : 'INVALID_TYPE',
+      '/documentVersion',
+    );
+  }
+
+  const sourceResult = validateSourceData(document['sourceData']);
+  if (!sourceResult.ok) {
+    const issue = sourceResult.errors[0];
+    return failure(
+      issue?.code ?? 'INVALID_SOURCE_DATA',
+      prefixPath('/sourceData', issue?.path ?? '/'),
+    );
+  }
+  const viewResult = validateViewSpec(document['viewSpec'], sourceResult.value);
+  if (!viewResult.ok) {
+    const issue = viewResult.errors[0];
+    return failure(issue?.code ?? 'INVALID_VIEW_SPEC', prefixPath('/viewSpec', issue?.path ?? '/'));
+  }
+
+  const configIssue =
+    validateAppearance(document['chartAppearance']) ??
+    validatePanels(document['panels']) ??
+    validateLayout(document['layout']);
+  if (configIssue !== undefined) {
+    return configIssue;
+  }
+
+  return {
+    ok: true,
+    value: {
+      documentVersion: PLAYGROUND_CHART_DOCUMENT_VERSION,
+      sourceData: sourceResult.value,
+      viewSpec: viewResult.value,
+      chartAppearance: document['chartAppearance'] as FinancialChartAppearance,
+      panels: document['panels'] as FinancialChartEditorPanels,
+      layout: document['layout'] as FinancialChartEditorLayout,
+    },
+  };
+}
