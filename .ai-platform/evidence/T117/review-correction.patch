+  type WaterfallSourceData,
+} from '@tellplot/editor';
+
+const chartAppearance: FinancialChartAppearance = {
+  title: '经营变动瀑布图',
+  palette: {
+    positive: '#168363',
+    negative: '#D5524A',
+    group: '#A46812',
+  },
+  axis: { x: true, y: true },
+  valueLabels: 'auto',
+  tooltip: true,
+  animation: { enabled: true, duration: 160 },
+  groupRegion: {
+    enabled: true,
+    fillOpacity: 0.06,
+    label: 'auto',
+  },
+  numberFormat: {
