+        onMove={onMove}
+      />,
+    );
+    emit(chart, 'plot:pointermove', { pointerId: 8, canvas: { x: 40, y: 160 } });
+    emit(chart, 'plot:pointerup', { pointerId: 8, canvas: { x: 40, y: 160 } });
