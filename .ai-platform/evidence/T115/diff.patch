+}
+
+type ChartCancelReason = 'cancelled' | 'invalid-target' | 'item-locked';
+
+export interface ChartDropTarget {
+  readonly nodeId: ViewNodeId;
+  readonly edge: MoveTargetEdge;
+}
+
+export type ChartInteractionPreview =
+  | { readonly state: 'idle' }
