+    constructor(readonly config: unknown) {
+      Chart.instances.push(this);
+    }
+  }
+  return { Chart };
+});
+
+vi.mock('@antv/g2', () => ({ Chart: g2Mock.Chart }));
+
+const projection = [
+  {
+    nodeId: 'a',
