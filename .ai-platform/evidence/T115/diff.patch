+    locked: false,
+    order: 0,
+  },
+  {
+    nodeId: 'b',
+    label: 'Beta',
+    amount: 20,
+    kind: 'positive',
+    sourceIds: ['b'],
+    locked: false,
+    order: 1,
+  },
+  {
+    nodeId: 'c',
+    label: 'Gamma',
+    amount: -5,
+    kind: 'negative',
+    sourceIds: ['c'],
+    locked: false,
+    order: 2,
+  },
+] as const satisfies CategoricalProjection;
+
+const viewSpec = {
+  schemaVersion: '2.0.0',
+  datasetId: 'categorical-canvas-fixture',
