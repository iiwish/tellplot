+    await waitFor(() => expect(ref.current).not.toBeNull());
+    const next = { ...first, revision: 4 };
+    rerender(
+      <StrictMode>
+        <FinancialChartEditor ref={ref} sourceData={financialSourceData} viewSpec={next} />
+      </StrictMode>,
