+    legendFilter: false,
+    legendHighlight: false,
+    tooltip: {
+      ...createSafeTooltipInteraction().tooltip,
+      shared: true,
+      sort: item => ordinalByName.get(item.name ?? '') ?? seriesLabels.length,
