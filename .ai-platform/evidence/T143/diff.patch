+          ],
+          kind: 'category',
+          sourceIds: ['south'],
+          locked: false,
+          order: 1,
+        },
+        {
+          nodeId: 'zero',
+          label: 'Zero',
+          values: [
+            { seriesId: 'actual', label: 'Actual', amount: 0 },
+            { seriesId: 'budget', label: 'Budget', amount: 0 },
+            { seriesId: 'forecast', label: 'Forecast', amount: 0 },
+          ],
+          kind: 'category',
+          sourceIds: ['zero'],
+          locked: false,
+          order: 2,
+        },
