+          .map(row => row.getAttribute('data-node-id') ?? 'missing-node-id');
+      const ordinal = (nodeId: string): number => {
+        const suffix = /([0-9]+)$/u.exec(nodeId)?.[1];
+        return suffix === undefined ? -1 : Number.parseInt(suffix, 10);
