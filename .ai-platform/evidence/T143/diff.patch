+          hash ^= pixels[offset + 1] ?? 0;
+          hash = Math.imul(hash, 16777619);
+          hash ^= pixels[offset + 2] ?? 0;
+          hash = Math.imul(hash, 16777619);
+          hash ^= pixels[offset + 3] ?? 0;
+          hash = Math.imul(hash, 16777619);
+        }
+        return hash >>> 0;
+      };
+      const prefix = (): readonly string[] =>
+        [...editor.querySelectorAll('[role="treeitem"][aria-level="1"][data-node-id]')]
