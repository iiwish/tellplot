+
+function rasterPixelSpan(
+  min: number,
+  max: number,
+  scale: number,
+  offset: number,
+): { readonly min: number; readonly max: number; readonly center: number } {
+  return {
+    min: offset + min * scale,
+    max: offset + (max + 1) * scale,
+    center: offset + ((min + max + 1) / 2) * scale,
+  };
+}
+
