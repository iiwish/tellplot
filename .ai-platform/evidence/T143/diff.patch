+  return {
+    ok: true,
+    value: {
+      ...point,
+      axis: receipt.axis,
+      nodeId,
+      edge,
+      min: category.axisBounds.min,
+      max: category.axisBounds.max,
+      target: edge === 'before' ? category.axisBounds.min : category.axisBounds.max,
+    },
