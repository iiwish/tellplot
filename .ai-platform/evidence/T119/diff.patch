@@ -0,0 +1,73 @@
+import {
+  FinancialChartEditor,
+  createInitialViewSpec,
+  type FinancialChartAppearance,
+} from '@tellplot/editor';
+
+import { EXAMPLE_CATALOG, type ShowcaseExampleId } from './exampleCatalog';
+import { getPlaygroundFixture } from './fixtures';
+
+const SHOWCASE_PALETTE = {
+  start: '#5F6B65',
+  positive: '#168363',
+  negative: '#D5524A',
+  subtotal: '#315C8C',
+  group: '#A46812',
+  end: '#315C8C',
+} as const;
+
+export interface ShowcaseChartProps {
+  readonly exampleId: ShowcaseExampleId;
+  readonly compact?: boolean;
+  readonly testId?: string;
+}
+
+export function ShowcaseChart({
+  exampleId,
+  compact = false,
+  testId,
+}: ShowcaseChartProps): React.JSX.Element {
+  const example = EXAMPLE_CATALOG.find(candidate => candidate.id === exampleId);
+  if (example === undefined) {
+    return <p role="alert">示例不存在</p>;
+  }
+
+  const sourceData = getPlaygroundFixture(example.fixtureSearch);
+  const result = createInitialViewSpec(
+    sourceData,
+    example.chartType === 'bar' ? { chartType: 'bar' } : undefined,
+  );
+  if (!result.ok) {
+    return <p role="alert">示例数据无法渲染</p>;
+  }
+
+  const appearance: FinancialChartAppearance = {
+    title: example.title,
+    palette: SHOWCASE_PALETTE,
+    axis: compact ? { x: false, y: true } : { x: true, y: true },
+    valueLabels: compact ? 'never' : 'auto',
+    tooltip: true,
+    animation: { enabled: true, duration: 220 },
+    groupRegion: { enabled: !compact, fillOpacity: 0.05, label: 'auto' },
+    numberFormat: {
+      minimumFractionDigits: 0,
+      maximumFractionDigits: sourceData.currency === undefined ? 2 : 0,
+      currencyDisplay: 'narrowSymbol',
+    },
+  };
+
+  return (
+    <div className="showcase-chart" data-example-id={example.id} data-testid={testId} inert>
+      <FinancialChartEditor
+        key={example.id}
+        sourceData={sourceData}
+        viewSpec={result.value}
+        height="100%"
+        locale="zh-CN"
+        readOnly
+        chartAppearance={appearance}
+        panels={{ outline: false, inspector: false, toolbar: false }}
+      />
+    </div>
+  );
+}
