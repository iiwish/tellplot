+  font-weight: 400;
+  line-height: 25px;
+}
+
+.site-hero__actions {
+  gap: 10px;
+  margin-top: 22px;
+}
+
+.site-button {
+  min-height: 42px;
+  gap: 8px;
+  padding: 0 18px;
+  border-color: var(--site-rule-strong);
+  border-radius: 6px;
+  font-size: 14px;
+  font-weight: 600;
+  transition:
+    transform 160ms ease,
+    border-color 160ms ease,
+    color 160ms ease,
+    background 160ms ease,
+    box-shadow 160ms ease;
+}
+
+.site-button:hover {
+  transform: translateY(-1px);
+}
+
+.site-button--primary {
+  border-color: var(--site-primary);
+  color: #ffffff;
+  background: var(--site-primary);
+  box-shadow: 0 6px 18px rgb(22 119 255 / 18%);
+}
+
+.site-button--primary:hover {
+  border-color: var(--site-primary-hover);
+  background: var(--site-primary-hover);
+}
+
+.site-button--quiet {
+  color: #344054;
+}
+
+.site-button--quiet:hover {
+  border-color: #8dbdff;
+  color: var(--site-primary);
+  background: #f4f8ff;
+}
+
+.site-hero__selector {
+  top: 76px;
+  right: 32px;
+  padding: 4px;
+  border-color: #d9e6f7;
+  border-radius: 7px;
+  background: #f4f7fb;
+}
+
+.site-hero__selector button {
+  min-height: 36px;
+  gap: 6px;
+  padding: 0 12px;
+  border-radius: 5px;
+  color: #667085;
+  font-size: 12px;
+}
+
+.site-hero__selector button span {
+  color: #646a73;
+  font-size: 9px;
+}
+
+.site-hero__selector button:hover {
+  color: var(--site-primary);
+}
+
+.site-hero__selector button[aria-pressed='true'] {
+  color: var(--site-primary);
+  background: #ffffff;
+  box-shadow: 0 2px 8px rgb(31 35 41 / 8%);
+}
+
+.site-hero__chart-plane {
+  inset: 350px 32px 24px;
+  padding-top: 35px;
+  border-top: 1px solid var(--site-rule);
+  animation-duration: 500ms;
+}
+
+.site-hero__chart-meta {
+  top: 8px;
+  color: var(--site-muted);
+  font-size: 12px;
+}
+
+.site-hero__chart-meta span {
+  color: var(--site-primary);
+  font-family: inherit;
+  font-size: 11px;
+  font-weight: 650;
+  text-transform: none;
+}
+
+.site-hero__chart-meta strong {
+  font-weight: 450;
+}
+
+.showcase-chart .tp-chart-stage {
+  padding: 8px 10px;
+}
+
+.site-capabilities,
+.site-example-ledger,
+.site-install-band,
+.site-page-intro,
+.site-example-next,
+.site-docs-layout {
+  width: min(100%, 1280px);
+}
+
+.site-capabilities,
+.site-example-ledger {
+  padding: 76px 32px;
+}
+
+.site-capabilities {
+  padding-top: 34px;
+  background: var(--site-canvas);
+}
+
+.site-section-heading {
+  grid-template-columns: minmax(300px, 0.9fr) minmax(340px, 1.1fr);
+  gap: 48px;
+  padding-bottom: 30px;
+  border-bottom: 0;
+}
+
+.site-section-heading > span {
+  grid-column: 1 / -1;
+  margin-bottom: -34px;
+}
+
+.site-section-heading h2 {
+  color: #14213d;
+  font-size: 32px;
+  font-weight: 680;
+  line-height: 42px;
+}
+
+.site-section-heading p {
+  color: var(--site-muted);
+  font-size: 15px;
+  line-height: 26px;
+}
+
+.site-capability-index {
+  gap: 16px;
+}
+
+.site-capability-index article {
+  min-height: 178px;
+  padding: 28px;
+  border: 1px solid var(--site-rule);
+  border-radius: 8px;
+  background: var(--site-paper);
+  box-shadow: 0 4px 16px rgb(31 35 41 / 3%);
+}
+
+.site-capability-index article + article {
+  padding-left: 28px;
+  border-left: 1px solid var(--site-rule);
+}
+
+.site-capability-index h3 {
+  margin: 0 0 10px;
+  color: #14213d;
+  font-size: 18px;
+}
+
+.site-capability-index p {
+  color: var(--site-muted);
+  font-size: 13px;
+  line-height: 22px;
+}
+
+.site-example-ledger {
+  background: var(--site-paper);
+}
+
+.site-example-ledger__rows {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 16px;
+  border-bottom: 0;
+}
+
+.site-example-ledger__rows > a {
+  grid-template-columns: minmax(0, 1fr) 20px;
+  grid-template-rows: auto auto;
+  gap: 18px 12px;
+  min-height: 132px;
+  padding: 24px;
+  border: 1px solid var(--site-rule);
+  border-radius: 8px;
+  background: #ffffff;
+}
+
+.site-example-ledger__rows > a:hover {
+  border-color: #91caff;
+  color: var(--site-primary);
+  background: #f7fbff;
+  transform: translateY(-2px);
+}
+
+.site-example-ledger__ordinal {
+  display: none;
+}
+
+.site-example-ledger__rows > a > span:nth-child(2) {
+  align-self: start;
+}
+
+.site-example-ledger__rows > a > span:nth-child(3) {
+  grid-column: 1 / -1;
+  color: var(--site-muted);
+  font-size: 13px;
+  line-height: 21px;
+}
+
+.site-example-ledger__rows > a > svg {
+  grid-column: 2;
+  grid-row: 1;
+  align-self: center;
+}
+
+.site-example-ledger__rows small {
+  color: var(--site-primary);
+  font-family: inherit;
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.site-example-ledger__rows strong {
+  color: #25324a;
+  font-size: 17px;
+}
+
+.site-install-band {
+  grid-template-columns: minmax(250px, 0.8fr) minmax(360px, 1.2fr) auto;
+  gap: 36px;
+  padding: 54px 32px;
+  color: var(--site-ink);
+  border: 1px solid #d6e8ff;
+  background: #eef6ff;
+}
+
+.site-install-band h2 {
+  margin-top: 6px;
+  color: #14213d;
+  font-size: 25px;
+}
+
+.site-install-band > div:first-child > span {
+  color: var(--site-primary);
+}
+
+.site-install-command {
+  min-height: 48px;
+  border-color: #b8d6ff;
+  border-radius: 6px;
+  background: #ffffff;
+  box-shadow: 0 4px 14px rgb(22 119 255 / 7%);
+}
+
+.site-install-command code {
+  color: #14213d;
+}
+
+.site-install-command button {
+  border-left-color: #d6e8ff;
+  color: var(--site-primary);
+}
+
+.site-install-command button:hover {
+  color: var(--site-primary-hover);
+  background: #f4f8ff;
+}
+
+.site-install-command > span {
+  color: var(--site-muted);
+}
+
+.site-install-band .site-text-link,
+.site-text-link {
+  color: var(--site-primary);
+}
+
+.site-footer {
+  grid-template-columns: minmax(260px, 1fr) auto minmax(260px, 1fr);
+  width: min(100%, 1280px);
+  min-height: 132px;
+  padding: 24px 32px;
+  border-top-color: var(--site-rule);
+}
+
+.site-footer__brand strong {
+  color: #14213d;
+}
+
+.site-footer__brand span,
+.site-footer__meta {
+  color: #646a73;
+}
+
+.site-footer nav a:hover {
+  color: var(--site-primary);
+}
+
+.site-page-intro {
+  min-height: 270px;
+  padding: 58px 32px 46px;
+  border-bottom-color: var(--site-rule);
+}
+
+.site-page-intro h1 {
+  margin: 10px 0 12px;
+  color: #14213d;
+  font-size: 42px;
+  line-height: 52px;
+}
+
+.site-page-intro > p:last-child {
+  color: var(--site-muted);
+  font-size: 15px;
+  line-height: 26px;
+}
+
+.site-page-intro--docs {
+  background: #f4f8ff;
+}
+
+.site-example-library-header {
+  display: flex;
+  width: min(100%, 1280px);
+  min-height: 210px;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 48px;
+  padding: 54px 32px 38px;
+  margin: 0 auto;
+  border-bottom: 1px solid var(--site-rule);
+  background: var(--site-paper);
+}
+
+.site-example-library-header h1 {
+  margin: 8px 0 8px;
+  color: #14213d;
+  font-size: 42px;
+  line-height: 50px;
+}
+
+.site-example-library-header p {
+  margin: 0;
+  color: var(--site-muted);
+  font-size: 15px;
+  line-height: 25px;
+}
+
+.site-example-search {
+  display: grid;
+  grid-template-columns: 20px minmax(0, 1fr) 32px;
+  width: 320px;
+  min-height: 44px;
+  align-items: center;
+  gap: 7px;
+  padding: 0 5px 0 13px;
+  border: 1px solid var(--site-rule-strong);
+  border-radius: 7px;
+  color: #646a73;
+  background: #ffffff;
+  transition:
+    border-color 160ms ease,
+    box-shadow 160ms ease;
+}
+
+.site-example-search:focus-within {
+  border-color: var(--site-primary);
+  box-shadow: 0 0 0 3px rgb(22 119 255 / 12%);
+}
+
+.site-example-search input {
+  width: 100%;
+  min-width: 0;
+  padding: 0;
+  border: 0;
+  outline: 0;
+  color: var(--site-ink);
+  background: transparent;
+  font: inherit;
+  font-size: 14px;
+}
+
+.site-example-search input::placeholder {
+  color: #646a73;
+}
+
+.site-example-search button {
+  display: inline-flex;
+  width: 30px;
+  height: 30px;
+  align-items: center;
+  justify-content: center;
+  padding: 0;
+  border: 0;
+  border-radius: 5px;
+  color: #646a73;
+  background: transparent;
+  cursor: pointer;
+}
+
+.site-example-search button:hover {
+  color: var(--site-primary);
+  background: #f2f3f5;
+}
+
+.site-example-browser {
+  display: grid;
+  grid-template-columns: 210px minmax(0, 1fr);
+  width: min(100%, 1280px);
+  align-items: start;
+  gap: 32px;
+  padding: 32px 32px 76px;
+  margin: 0 auto;
+}
+
+.site-example-sidebar {
+  position: sticky;
+  top: 92px;
+  min-width: 0;
+  padding-right: 24px;
+  border-right: 1px solid var(--site-rule);
+}
+
+.site-example-sidebar > strong {
+  display: block;
+  margin-bottom: 14px;
+  color: #344054;
+  font-size: 13px;
+}
+
+.site-example-sidebar nav {
+  display: grid;
+  gap: 4px;
+}
+
+.site-example-sidebar nav button {
+  display: flex;
+  min-height: 42px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 0 12px;
+  border: 0;
+  border-radius: 6px;
+  color: #4e5969;
+  background: transparent;
+  font: inherit;
+  font-size: 14px;
+  text-align: left;
+  cursor: pointer;
+}
+
+.site-example-sidebar nav button:hover {
+  color: var(--site-primary);
+  background: #f2f7ff;
+}
+
+.site-example-sidebar nav button[aria-pressed='true'] {
+  color: var(--site-primary);
+  background: #eaf3ff;
+  font-weight: 600;
+}
+
+.site-example-sidebar nav small {
+  min-width: 22px;
+  color: #646a73;
+  font-size: 11px;
+  text-align: right;
+}
+
+.site-example-sidebar__note {
+  padding: 20px 12px 0;
+  margin-top: 22px;
+  border-top: 1px solid var(--site-rule);
+}
+
+.site-example-sidebar__note strong {
+  color: var(--site-primary);
+  font-size: 12px;
+}
+
+.site-example-sidebar__note p {
+  margin: 6px 0 0;
+  color: #646a73;
+  font-size: 11px;
+  line-height: 18px;
+}
+
+.site-example-results {
+  min-width: 0;
+}
+
+.site-example-results__header {
+  display: flex;
+  min-height: 56px;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 24px;
+  margin-bottom: 18px;
+}
+
+.site-example-results__header h2 {
+  margin: 0 0 4px;
+  color: #14213d;
+  font-size: 24px;
+  line-height: 32px;
+}
+
+.site-example-results__header p,
+.site-example-results__header > span {
+  margin: 0;
+  color: #646a73;
+  font-size: 12px;
+  line-height: 20px;
+}
+
+.site-example-results__header > span {
+  padding-top: 6px;
+}
+
+.site-example-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 18px;
+  width: auto;
+  padding: 0;
+  margin: 0;
+}
+
+.site-example-card {
+  display: grid;
+  grid-template-rows: 290px auto;
+  min-width: 0;
+  overflow: hidden;
+  border: 1px solid var(--site-rule);
+  border-radius: 8px;
+  background: var(--site-paper);
+  box-shadow: 0 3px 12px rgb(31 35 41 / 3%);
+  transition:
+    border-color 180ms ease,
+    transform 180ms ease,
+    box-shadow 180ms ease;
+}
+
+.site-example-card:first-child {
+  grid-row: auto;
+}
+
+.site-example-card:hover,
+.site-example-card:focus-within {
+  border-color: #91caff;
+  box-shadow: 0 10px 24px rgb(31 35 41 / 8%);
+  transform: translateY(-2px);
+}
+
+.site-example-card__preview,
+.site-example-card:first-child .site-example-card__preview {
+  position: relative;
+  min-height: 0;
+  background: #ffffff;
+}
+
+.site-example-card__preview .tp-chart-stage__header {
+  display: none;
+}
+
+.site-example-card__preview .tp-chart-stage {
+  padding: 12px 8px 6px;
+}
+
+.site-example-card__open {
+  position: absolute;
+  right: 14px;
+  bottom: 14px;
+  z-index: 5;
+  display: inline-flex;
+  min-height: 34px;
+  align-items: center;
+  gap: 6px;
+  padding: 0 11px;
+  border: 1px solid #b8d6ff;
+  border-radius: 6px;
+  color: var(--site-primary);
+  background: rgb(255 255 255 / 96%);
+  box-shadow: 0 5px 14px rgb(31 35 41 / 10%);
+  font-size: 12px;
+  font-weight: 600;
+  text-decoration: none;
+  opacity: 0;
+  transform: translateY(4px);
+  transition:
+    opacity 160ms ease,
+    transform 160ms ease,
+    background 160ms ease;
+}
+
+.site-example-card:hover .site-example-card__open,
+.site-example-card:focus-within .site-example-card__open {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+.site-example-card__open:hover {
+  color: #ffffff;
+  background: var(--site-primary);
+}
+
+.site-example-card__body {
+  display: grid;
+  gap: 12px;
+  min-height: 170px;
+  padding: 18px 20px 20px;
+  border-top: 1px solid var(--site-rule);
+}
+
+.site-example-card__body > div:first-child {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.site-example-card__body small {
+  order: 2;
+  color: var(--site-primary);
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.site-example-card__body h3 {
+  margin: 0;
+  color: #25324a;
+  font-size: 17px;
+  line-height: 25px;
+}
+
+.site-example-card__body p {
+  margin: 0;
+  color: var(--site-muted);
+  font-size: 12px;
+  line-height: 20px;
+}
+
+.site-example-card__tags {
+  display: flex;
+  align-items: flex-end;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.site-example-card__tags span {
+  padding: 3px 7px;
+  border-radius: 4px;
+  color: #566071;
+  background: #f2f3f5;
+  font-size: 10px;
+}
+
+.site-example-empty {
+  display: flex;
+  min-height: 420px;
+  align-items: center;
+  justify-content: center;
+  flex-direction: column;
+  padding: 48px 24px;
+  border: 1px dashed var(--site-rule-strong);
+  border-radius: 8px;
+  color: #646a73;
+  background: #ffffff;
+  text-align: center;
+}
+
+.site-example-empty h3 {
+  margin: 14px 0 6px;
+  color: #344054;
+  font-size: 18px;
+}
+
+.site-example-empty p {
+  margin: 0 0 18px;
+  font-size: 13px;
+}
+
+.site-example-empty button {
+  min-height: 36px;
+  padding: 0 13px;
+  border: 1px solid #b8d6ff;
+  border-radius: 6px;
+  color: var(--site-primary);
+  background: #ffffff;
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+}
+
+.site-example-next {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 36px;
+  padding: 48px 32px;
+  border-top: 1px solid var(--site-rule);
+  background: var(--site-paper);
+}
+
+.site-example-next > div {
+  min-width: 280px;
+}
+
+.site-example-next h2 {
+  margin: 5px 0 0;
+  color: #14213d;
+  font-size: 24px;
+  line-height: 32px;
+}
+
+.site-example-next p {
+  max-width: 520px;
+  color: var(--site-muted);
+  font-size: 13px;
+  line-height: 22px;
+}
+
+.site-docs {
+  background: var(--site-paper);
+}
+
+.site-docs-layout {
+  grid-template-columns: 190px minmax(0, 760px) minmax(190px, 1fr);
+  gap: 44px;
+  padding: 48px 32px 100px;
+}
+
+.site-docs-nav {
+  top: 88px;
+}
+
+.site-docs-nav a {
+  padding: 8px 10px;
+  border-radius: 5px;
+  color: #4e5969;
+  font-size: 13px;
+}
+
+.site-docs-nav a:hover {
+  color: var(--site-primary);
+  background: #f2f7ff;
+}
+
+.site-docs-content > section + section {
+  border-top-color: var(--site-rule);
+}
+
+.site-docs-content section > header svg {
+  color: var(--site-primary);
+}
+
+.site-docs-content section > header span {
+  color: #646a73;
+}
+
+.site-docs-content h2 {
+  color: #14213d;
+}
+
+.site-docs-content p {
+  color: var(--site-muted);
+}
+
+.site-docs-content pre {
+  border-color: #dce6f3;
+  color: #25324a;
+  background: #f6f8fb;
+}
+
+.site-docs-callout {
+  border-left-color: var(--site-primary);
+  background: #f2f7ff;
+}
+
+.site-docs-meta {
+  top: 88px;
+}
+
+.site-not-found {
+  background: var(--site-paper);
+}
+
+.site-app :is(a, button, input):focus-visible {
+  outline: 2px solid var(--site-primary);
+  outline-offset: 3px;
+}
+
+@media (max-width: 1120px) {
+  .site-header__inner {
+    grid-template-columns: 180px minmax(0, 1fr) 170px;
+    padding-right: 24px;
+    padding-left: 24px;
+  }
+
+  .site-hero__selector {
+    right: 24px;
+  }
+
+  .site-hero,
+  .site-example-library-header {
+    padding-right: 24px;
+    padding-left: 24px;
+  }
+
+  .site-hero__chart-plane {
+    right: 24px;
+    left: 24px;
+  }
+
+  .site-capabilities,
+  .site-example-ledger,
+  .site-install-band,
+  .site-example-browser,
+  .site-example-next,
+  .site-docs-layout {
+    padding-right: 24px;
+    padding-left: 24px;
+  }
+
+  .site-example-browser {
+    grid-template-columns: 180px minmax(0, 1fr);
+    gap: 24px;
+  }
+
+  .site-example-grid {
+    grid-template-columns: repeat(2, minmax(260px, 1fr));
