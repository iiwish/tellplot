+  --site-paper: #ffffff;
+  --site-ink: #17221d;
+  --site-muted: #5d6b64;
+  --site-rule: #d8deda;
+  --site-rule-strong: #adb8b2;
+  --site-emerald: #126e57;
+  --site-coral: #a33a34;
+  --site-blue: #315c8c;
+  --site-amber: #a46812;
+  min-height: 100%;
+  color: var(--site-ink);
+  background: var(--site-canvas);
+}
+
+.site-app,
+.site-app * {
+  box-sizing: border-box;
+}
+
+.site-app[data-route='playground'] {
   display: grid;
-  grid-template-rows: 46px minmax(0, 1fr);
+  grid-template-rows: 64px minmax(0, 1fr);
+  height: 100%;
+  overflow: hidden;
+}
+
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 100;
+  height: 64px;
+  border-bottom: 1px solid var(--site-rule);
+  background: rgb(255 255 255 / 96%);
+}
+
+.site-header__inner {
+  display: grid;
+  grid-template-columns: minmax(190px, 1fr) auto minmax(190px, 1fr);
+  width: min(100%, 1440px);
+  height: 100%;
+  align-items: center;
+  padding: 0 40px;
+  margin: 0 auto;
+}
+
+.site-brand,
+.site-desktop-nav,
+.site-header__workbench,
+.site-mobile-nav a,
+.site-footer nav,
+.site-footer nav a,
+.site-button,
+.site-text-link {
+  display: inline-flex;
+  align-items: center;
+}
+
+.site-brand {
+  justify-self: start;
+  gap: 10px;
+  color: var(--site-ink);
+  text-decoration: none;
+}
+
+.site-brand__mark {
+  display: flex;
+  width: 24px;
+  height: 24px;
+  align-items: flex-end;
+  justify-content: center;
+  gap: 2px;
+  padding: 5px;
+  border: 1px solid var(--site-ink);
+}
+
+.site-brand__mark span {
+  width: 3px;
+  background: var(--site-ink);
+}
+
+.site-brand__mark span:nth-child(1) {
+  height: 6px;
+}
+
+.site-brand__mark span:nth-child(2) {
+  height: 12px;
+  background: var(--site-emerald);
+}
+
+.site-brand__mark span:nth-child(3) {
+  height: 9px;
+}
+
+.site-brand strong {
+  font-size: 17px;
+  line-height: 1;
+}
+
+.site-brand__version {
+  padding-left: 9px;
+  border-left: 1px solid var(--site-rule);
+  color: var(--site-muted);
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 9px;
+}
+
+.site-desktop-nav {
+  align-self: stretch;
+  justify-content: center;
+  gap: 30px;
+}
+
+.site-desktop-nav a {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  color: #435149;
+  font-size: 13px;
+  font-weight: 560;
+  text-decoration: none;
+}
+
+.site-desktop-nav a::after {
+  position: absolute;
+  right: 0;
+  bottom: -1px;
+  left: 0;
+  height: 2px;
+  background: var(--site-emerald);
+  content: '';
+  opacity: 0;
+  transform: scaleX(0.4);
+  transition:
+    opacity 180ms ease,
+    transform 180ms ease;
+}
+
+.site-desktop-nav a:hover,
+.site-desktop-nav a[aria-current='page'] {
+  color: var(--site-ink);
+}
+
+.site-desktop-nav a[aria-current='page']::after {
+  opacity: 1;
+  transform: scaleX(1);
+}
+
+.site-header__workbench {
+  justify-self: end;
+  gap: 7px;
+  min-height: 34px;
+  padding: 0 11px;
+  border: 1px solid var(--site-rule-strong);
+  border-radius: 5px;
+  color: var(--site-ink);
+  background: var(--site-paper);
+  font-size: 12px;
+  font-weight: 620;
+  text-decoration: none;
+  transition:
+    border-color 160ms ease,
+    color 160ms ease,
+    background 160ms ease;
+}
+
+.site-header__workbench:hover,
+.site-header__workbench[aria-current='page'] {
+  border-color: var(--site-emerald);
+  color: #ffffff;
+  background: var(--site-emerald);
+}
+
+.site-mobile-menu-button,
+.site-mobile-nav {
+  display: none;
+}
+
+.site-main {
+  width: 100%;
+}
+
+.site-kicker,
+.site-section-heading > span,
+.site-install-band > div:first-child > span,
+.site-example-next > span,
+.site-docs-meta > span,
+.site-not-found > span {
+  margin: 0;
+  color: var(--site-emerald);
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 11px;
+  font-weight: 700;
+  line-height: 1.5;
+}
+
+.site-hero {
+  position: relative;
+  width: min(100%, 1440px);
+  min-height: min(720px, calc(100dvh - 164px));
+  padding: 48px 40px 24px;
+  margin: 0 auto;
+  overflow: hidden;
+  border-bottom: 1px solid var(--site-rule);
+  background: var(--site-paper);
+}
+
+.site-hero::before {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 40px;
+  width: 1px;
+  background: var(--site-rule);
+  content: '';
+  opacity: 0.7;
+}
+
+.site-hero__intro {
+  position: relative;
+  z-index: 3;
+  max-width: 620px;
+  padding-left: 24px;
+  animation: site-intro-enter 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
+.site-hero h1 {
+  margin: 12px 0 10px;
+  color: var(--site-ink);
+  font-size: 64px;
+  font-weight: 730;
+  line-height: 68px;
+  letter-spacing: 0;
+}
+
+.site-hero__summary {
+  max-width: 590px;
+  margin: 0;
+  color: #2c3932;
+  font-size: 18px;
+  font-weight: 590;
+  line-height: 29px;
+}
+
+.site-hero__summary span {
+  display: block;
+  color: var(--site-muted);
+  font-size: 15px;
+  font-weight: 430;
+}
+
+.site-hero__actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-top: 20px;
+}
+
+.site-button {
+  justify-content: center;
+  gap: 8px;
+  min-height: 40px;
+  padding: 0 15px;
+  border: 1px solid var(--site-rule-strong);
+  border-radius: 5px;
+  color: var(--site-ink);
+  background: var(--site-paper);
+  font-size: 13px;
+  font-weight: 650;
+  text-decoration: none;
+  transition:
+    transform 180ms ease,
+    border-color 180ms ease,
+    background 180ms ease;
+}
+
+.site-button:hover {
+  transform: translateY(-2px);
+}
+
+.site-button--primary {
+  border-color: var(--site-emerald);
+  color: #ffffff;
+  background: var(--site-emerald);
+}
+
+.site-button--primary:hover {
+  background: #0d5a47;
+}
+
+.site-button--quiet:hover {
+  border-color: var(--site-ink);
+  background: #f8faf9;
+}
+
+.site-hero__selector {
+  position: absolute;
+  top: 54px;
+  right: 40px;
+  z-index: 4;
+  display: flex;
+  padding: 3px;
+  border: 1px solid var(--site-rule);
+  border-radius: 6px;
+  background: var(--site-canvas);
+}
+
+.site-hero__selector button {
+  display: inline-flex;
+  min-height: 34px;
+  align-items: center;
+  gap: 7px;
+  padding: 0 10px;
+  border: 0;
+  border-radius: 4px;
+  color: var(--site-muted);
+  background: transparent;
+  font: inherit;
+  font-size: 12px;
+  cursor: pointer;
+  transition:
+    color 160ms ease,
+    background 160ms ease;
+}
+
+.site-hero__selector button span {
+  color: #7b8881;
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 9px;
+}
+
+.site-hero__selector button:hover {
+  color: var(--site-ink);
+}
+
+.site-hero__selector button[aria-pressed='true'] {
+  color: var(--site-ink);
+  background: var(--site-paper);
+  box-shadow: 0 1px 4px rgb(23 34 29 / 10%);
+}
+
+.site-hero__chart-plane {
+  position: absolute;
+  inset: 245px 40px 24px 64px;
+  z-index: 1;
+  min-height: 0;
+  animation: site-chart-enter 620ms 80ms cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
+.site-hero__chart-plane::after {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  left: 0;
+  height: 1px;
+  background: var(--site-rule);
+  content: '';
+}
+
+.site-hero__chart-meta {
+  position: absolute;
+  top: -33px;
+  right: 0;
+  left: 0;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  color: var(--site-muted);
+  font-size: 12px;
+}
+
+.site-hero__chart-meta span {
+  color: var(--site-blue);
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 10px;
+  text-transform: uppercase;
+}
+
+.site-hero__chart-meta strong {
+  font-weight: 520;
+}
+
+.showcase-chart {
+  width: 100%;
+  height: 100%;
+  min-height: 0;
+}
+
+.showcase-chart .tp-editor,
+.showcase-chart .tp-chart-stage {
+  min-height: 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+}
+
+.showcase-chart .tp-editor[data-toolbar-visible='false'] {
+  grid-template-rows: minmax(0, 1fr);
+}
+
+.showcase-chart .tp-command-feedback {
+  display: none;
+}
+
+.showcase-chart .tp-chart-stage {
+  padding: 8px 14px 8px;
+}
+
+.showcase-chart .tp-chart-stage__plot-shell {
+  min-height: 0;
+}
+
+.showcase-chart .tp-chart-stage__header {
+  padding: 0 4px;
+}
+
+.site-capabilities,
+.site-example-ledger,
+.site-install-band,
+.site-page-intro,
+.site-example-grid,
+.site-example-next,
+.site-docs-layout {
+  width: min(100%, 1440px);
+  margin-right: auto;
+  margin-left: auto;
+}
+
+.site-capabilities,
+.site-example-ledger {
+  padding: 104px 40px;
+}
+
+.site-capabilities {
+  padding-top: 48px;
+  background: var(--site-canvas);
+}
+
+.site-section-heading {
+  display: grid;
+  grid-template-columns: 180px minmax(280px, 0.9fr) minmax(300px, 1.1fr);
+  align-items: start;
+  gap: 32px;
+  padding-bottom: 38px;
+  border-bottom: 1px solid var(--site-rule-strong);
+}
+
+.site-section-heading h2 {
+  margin: 0;
+  color: var(--site-ink);
+  font-size: 30px;
+  font-weight: 680;
+  line-height: 40px;
+  letter-spacing: 0;
+}
+
+.site-section-heading p {
+  max-width: 620px;
+  margin: 3px 0 0;
+  color: var(--site-muted);
+  font-size: 15px;
+  line-height: 26px;
+}
+
+.site-capability-index {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.site-capability-index article {
+  min-height: 205px;
+  padding: 30px 32px 24px 0;
+  border-bottom: 1px solid var(--site-rule);
+}
+
+.site-capability-index article + article {
+  padding-left: 32px;
+  border-left: 1px solid var(--site-rule);
+}
+
+.site-capability-index article > span {
+  color: var(--site-coral);
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 11px;
+}
+
+.site-capability-index h3 {
+  margin: 42px 0 8px;
+  font-size: 18px;
+  line-height: 25px;
+}
+
+.site-capability-index p {
+  max-width: 330px;
+  margin: 0;
+  color: var(--site-muted);
+  font-size: 13px;
+  line-height: 22px;
+}
+
+.site-example-ledger {
+  background: var(--site-paper);
+}
+
+.site-example-ledger__rows {
+  border-bottom: 1px solid var(--site-rule);
+}
+
+.site-example-ledger__rows > a {
+  display: grid;
+  grid-template-columns: 72px minmax(180px, 0.7fr) minmax(260px, 1.3fr) 24px;
+  align-items: center;
+  gap: 24px;
+  min-height: 96px;
+  border-top: 1px solid var(--site-rule);
+  color: var(--site-ink);
+  text-decoration: none;
+  transition:
+    color 180ms ease,
+    transform 180ms ease,
+    background 180ms ease;
+}
+
+.site-example-ledger__rows > a:hover {
+  color: var(--site-emerald);
+  background: #f8faf9;
+  transform: translateX(3px);
+}
+
+.site-example-ledger__ordinal {
+  color: var(--site-coral);
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 12px;
+}
+
+.site-example-ledger__rows small,
+.site-example-ledger__rows strong {
+  display: block;
+}
+
+.site-example-ledger__rows small {
+  margin-bottom: 4px;
+  color: var(--site-muted);
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 10px;
+}
+
+.site-example-ledger__rows strong {
+  font-size: 16px;
+}
+
+.site-example-ledger__rows > a > span:nth-child(3) {
+  color: var(--site-muted);
+  font-size: 13px;
+  line-height: 21px;
+}
+
+.site-install-band {
+  display: grid;
+  grid-template-columns: minmax(280px, 0.8fr) minmax(360px, 1.2fr) auto;
+  align-items: center;
+  gap: 40px;
+  padding: 62px 40px;
+  color: #ffffff;
+  background: var(--site-ink);
+}
+
+.site-install-band h2 {
+  margin: 8px 0 0;
+  font-size: 25px;
+  line-height: 34px;
+}
+
+.site-install-band > div:first-child > span {
+  color: #72c7ac;
+}
+
+.site-install-command {
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 42px;
+  min-height: 48px;
+  align-items: center;
+  border: 1px solid #53625b;
+  background: #202d27;
+}
+
+.site-install-command code {
+  min-width: 0;
+  padding: 0 18px;
+  overflow: hidden;
+  color: #f7faf8;
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 13px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.site-install-command button {
+  display: inline-flex;
+  height: 46px;
+  align-items: center;
+  justify-content: center;
+  padding: 0;
+  border: 0;
+  border-left: 1px solid #53625b;
+  color: #d8e4de;
+  background: transparent;
+  cursor: pointer;
+}
+
+.site-install-command button:hover {
+  color: #ffffff;
+  background: #2c3b34;
+}
+
+.site-install-command > span {
+  position: absolute;
+  right: 0;
+  bottom: -24px;
+  color: #a9bbb2;
+  font-size: 10px;
+}
+
+.site-install-band .site-text-link {
+  color: #ffffff;
+}
+
+.site-text-link {
+  gap: 7px;
+  color: var(--site-emerald);
+  font-size: 13px;
+  font-weight: 650;
+  text-decoration: none;
+}
+
+.site-text-link svg {
+  transition: transform 180ms ease;
+}
+
+.site-text-link:hover svg {
+  transform: translateX(3px);
+}
+
+.site-footer {
+  display: grid;
+  grid-template-columns: minmax(260px, 1fr) auto minmax(260px, 1fr);
+  width: min(100%, 1440px);
+  min-height: 150px;
+  align-items: center;
+  gap: 28px;
+  padding: 28px 40px;
+  margin: 0 auto;
+  border-top: 1px solid var(--site-rule);
+  background: var(--site-paper);
+}
+
+.site-footer__brand strong,
+.site-footer__brand span {
+  display: block;
+}
+
+.site-footer__brand strong {
+  margin-bottom: 5px;
+  font-size: 17px;
+}
+
+.site-footer__brand span,
+.site-footer__meta {
+  color: var(--site-muted);
+  font-size: 11px;
+}
+
+.site-footer nav {
+  justify-content: center;
+  gap: 22px;
+}
+
+.site-footer nav a {
+  gap: 4px;
+  color: var(--site-ink);
+  font-size: 12px;
+  text-decoration: none;
+}
+
+.site-footer nav a:hover {
+  color: var(--site-emerald);
+}
+
+.site-footer__meta {
+  justify-self: end;
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+}
+
+.site-page-intro {
+  min-height: 315px;
+  padding: 72px 40px 54px;
+  border-bottom: 1px solid var(--site-rule);
+  background: var(--site-paper);
+}
+
+.site-page-intro h1 {
+  max-width: 820px;
+  margin: 15px 0 14px;
+  font-size: 48px;
+  font-weight: 720;
+  line-height: 56px;
+  letter-spacing: 0;
+}
+
+.site-page-intro > p:last-child {
+  max-width: 740px;
+  margin: 0;
+  color: var(--site-muted);
+  font-size: 16px;
+  line-height: 28px;
+}
+
+.site-page-intro code,
+.site-docs-content p code {
+  color: var(--site-ink);
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 0.9em;
+}
+
+.site-example-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 7fr) minmax(360px, 5fr);
+  gap: 16px;
+  padding: 24px 40px 100px;
+}
+
+.site-example-card {
+  display: grid;
+  grid-template-rows: auto minmax(300px, 1fr) auto;
+  min-width: 0;
+  overflow: hidden;
+  border: 1px solid var(--site-rule);
+  border-radius: 8px;
+  background: var(--site-paper);
+  transition:
+    border-color 180ms ease,
+    transform 180ms ease,
+    box-shadow 180ms ease;
+}
+
+.site-example-card:first-child {
+  grid-row: span 2;
+}
+
+.site-example-card:hover,
+.site-example-card:focus-within {
+  border-color: var(--site-rule-strong);
+  box-shadow: 0 14px 34px rgb(23 34 29 / 8%);
+  transform: translateY(-3px);
+}
+
+.site-example-card > header {
+  min-height: 164px;
+  padding: 24px 26px 20px;
+  border-bottom: 1px solid var(--site-rule);
+}
+
+.site-example-card > header > div {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.site-example-card > header span,
+.site-example-card > header small {
+  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
+  font-size: 10px;
+}
+
+.site-example-card > header span {
+  color: var(--site-coral);
+}
+
+.site-example-card > header small {
+  color: var(--site-muted);
+}
+
+.site-example-card h2 {
+  margin: 28px 0 7px;
+  font-size: 22px;
+  line-height: 29px;
+}
+
+.site-example-card > header p {
+  max-width: 520px;
+  margin: 0;
+  color: var(--site-muted);
+  font-size: 13px;
+  line-height: 22px;
+}
+
+.site-example-card__preview {
+  min-height: 320px;
+  background: #f8faf9;
+}
+
+.site-example-card:first-child .site-example-card__preview {
+  min-height: 650px;
+}
+
+.site-example-card > footer {
+  display: flex;
+  min-height: 64px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 12px 18px 12px 24px;
+  border-top: 1px solid var(--site-rule);
+}
+
+.site-example-card > footer > div {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.site-example-card > footer > div span {
+  padding: 3px 7px;
+  border: 1px solid var(--site-rule);
+  border-radius: 4px;
+  color: var(--site-muted);
+  font-size: 10px;
+}
+
+.site-example-card[data-accent='blue'] > header span {
+  color: var(--site-blue);
+}
+
+.site-example-card[data-accent='coral'] > header span {
+  color: var(--site-coral);
+}
+
+.site-example-next {
+  display: grid;
+  grid-template-columns: 180px minmax(300px, 0.8fr) minmax(300px, 1fr) auto;
+  align-items: start;
+  gap: 32px;
+  padding: 68px 40px;
+  border-top: 1px solid var(--site-rule);
+  background: var(--site-paper);
+}
+
+.site-example-next h2,
+.site-example-next p {
+  margin: 0;
+}
+
+.site-example-next h2 {
+  font-size: 24px;
+  line-height: 33px;
+}
+
+.site-example-next p {
+  color: var(--site-muted);
+  font-size: 13px;
+  line-height: 22px;
+}
+
+.site-docs {
+  background: var(--site-paper);
+}
+
+.site-page-intro--docs {
+  background: var(--site-canvas);
+}
+
+.site-docs-layout {
