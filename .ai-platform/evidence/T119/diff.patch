+    padding: 24px;
+    border-left: 1px solid var(--site-rule);
+  }
+
+  .site-example-ledger__rows > a {
+    min-height: 120px;
+  }
+
+  .site-install-band {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 24px;
+    padding: 42px 18px 48px;
+    border-right: 0;
+    border-left: 0;
+  }
+
+  .site-install-band .site-text-link {
+    grid-column: auto;
+  }
+
+  .site-footer {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 22px;
+    padding: 32px 18px;
+  }
