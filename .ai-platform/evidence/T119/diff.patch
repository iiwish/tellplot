+
+  .site-docs-layout {
+    grid-template-columns: 170px minmax(0, 1fr);
+  }
+
+  .site-docs-meta {
+    display: none;
+  }
+
+  .site-install-band {
+    grid-template-columns: minmax(250px, 0.8fr) minmax(330px, 1.2fr);
+  }
+}
+
