+
+  .site-mobile-nav a[aria-current='page'] {
+    color: var(--site-primary);
+  }
+
+  .site-hero {
+    min-height: 0;
+    padding: 48px 18px 22px;
+  }
+
+  .site-hero__intro {
+    padding-left: 0;
+  }
+
+  .site-hero h1 {
+    margin-top: 7px;
+    font-size: 42px;
+    line-height: 49px;
+  }
+
+  .site-hero__summary {
+    font-size: 18px;
+    line-height: 28px;
