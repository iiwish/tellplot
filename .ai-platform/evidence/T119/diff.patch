+/* Website visual system: clean product stage and scalable chart gallery. */
+.site-app {
+  --site-canvas: #f7f8fa;
+  --site-paper: #ffffff;
+  --site-ink: #1f2329;
+  --site-muted: #646a73;
+  --site-rule: #e5e6eb;
+  --site-rule-strong: #c9cdd4;
+  --site-primary: #0b5fcc;
+  --site-primary-hover: #084ca6;
+  --site-cyan: #13a8a8;
+  --site-coral: #d94743;
+  --site-blue: #3b82f6;
+  --site-amber: #d48806;
+  color: var(--site-ink);
+  background: var(--site-canvas);
+}
+
+.site-app[data-route='playground'] {
+  grid-template-rows: 60px minmax(0, 1fr);
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  border: 0;
+  white-space: nowrap;
+}
+
+.site-header {
+  height: 60px;
+  border-bottom: 1px solid var(--site-rule);
+  background: rgb(255 255 255 / 98%);
+  box-shadow: 0 3px 14px rgb(31 35 41 / 5%);
+}
+
+.site-header__inner {
+  grid-template-columns: minmax(210px, 1fr) auto minmax(210px, 1fr);
+  width: min(100%, 1280px);
+  padding: 0 32px;
+}
+
+.site-brand {
+  gap: 9px;
+}
+
+.site-brand__mark {
+  width: 27px;
+  height: 27px;
+  gap: 2px;
+  padding: 6px 5px;
+  border: 0;
+  border-radius: 6px;
+  background: var(--site-primary);
+}
+
+.site-brand__mark span {
+  width: 3px;
+  border-radius: 1px 1px 0 0;
+  background: #ffffff;
+}
+
+.site-brand__mark span:nth-child(1),
+.site-brand__mark span:nth-child(2),
+.site-brand__mark span:nth-child(3) {
+  background: #ffffff;
+}
+
+.site-brand strong {
+  font-size: 18px;
+  font-weight: 700;
+}
+
+.site-brand__version {
+  padding: 2px 5px;
+  border: 0;
+  border-radius: 3px;
+  color: #5b5f66;
+  background: #f2f3f5;
+  font-family: inherit;
+  font-size: 9px;
+  font-weight: 650;
+}
+
+.site-desktop-nav {
+  gap: 34px;
+}
+
+.site-desktop-nav a {
+  color: #4e5969;
+  font-size: 14px;
+  font-weight: 500;
+}
+
+.site-desktop-nav a::after {
+  height: 2px;
+  background: var(--site-primary);
+}
+
+.site-desktop-nav a:hover,
+.site-desktop-nav a[aria-current='page'] {
+  color: var(--site-primary);
+}
+
+.site-header__workbench {
+  min-height: 36px;
+  gap: 7px;
+  padding: 0 13px;
+  border-color: #b8d6ff;
+  color: var(--site-primary);
+  background: #f4f8ff;
+  font-size: 13px;
+}
+
+.site-header__workbench:hover,
+.site-header__workbench[aria-current='page'] {
+  border-color: var(--site-primary);
+  color: #ffffff;
+  background: var(--site-primary);
+}
+
+.site-kicker,
+.site-section-heading > span,
+.site-install-band > div:first-child > span,
+.site-example-next span,
+.site-docs-meta > span,
+.site-not-found > span {
+  color: var(--site-primary);
+  font-family: inherit;
+  font-size: 12px;
+  font-weight: 650;
+  line-height: 20px;
+  text-transform: none;
+}
+
+.site-hero {
+  width: min(100%, 1280px);
+  min-height: min(760px, calc(100dvh - 104px));
+  padding: 72px 32px 24px;
+  border-bottom: 0;
+  background: var(--site-paper);
+}
+
+.site-hero::before,
+.site-hero__chart-plane::after {
+  display: none;
+}
+
+.site-hero__intro {
+  max-width: 720px;
+  padding-left: 0;
+  animation-duration: 420ms;
+}
+
+.site-hero h1 {
